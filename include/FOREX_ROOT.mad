  0o510320  ,A-X,TIME.             ; S1:15493  время счёта
  0o510320  ,A*X,TIME_SCALE           ; S1:15494  масштаб 100.0
  0o510321  ,NTR,REAL_MODE_3                 ; S1:15495
  0o510321  ,A+X,A/I0              ; S1:15496
  0o510322  ,AEX,A/I0              ; S1:15497
  0o510322  ,CALL,OCT_DEC          ; S1:15498  dec print
  0o510323  ,APX,TIME_SEP_A   ; S1:15499  разделители времени
  0o510323  ,AUX,TIME_SEP_B   ; S1:15500
  0o510324  ,AOX,TIME_SEP_C            ; S1:15501
  0o510324  ,ATX,TIME.             ; S1:15502
  0o510325  13,VTM,TTEX            ; S1:15503  M13 = база текстовых констант
  PRINT_MESSAGE:,*64,INF              ; (PRIN)                    ; S1:15504  *64 4037
  0o510327  ,NTR,MODE_6.                ; S1:15505
  0o510327  ,XTA,*DUMON*+3         ; S1:15506
  0o510330  ,ATX,FLGEX*            ; S1:15507
  0o510330  ,WTC,RET.              ; S1:15508
  0o510331  13,VTM,.               ; S1:15509
  0o510331  ,UJ,PAGE_TAKE.  ; (TAK/PG)            ; S1:15510  передача управления TAK/PG

