C***********************************************************************
C*  FOREX* — корневой модуль компилятора ФОРЭКС ИПМ АН СССР              *
C*  Аннотированный МАДЛЕН-текст (этап 3 плана)                            *
C*                                                                        *
C*  ПРОИСХОЖДЕНИЕ ТЕКСТА:                                                  *
C*   S1  /home/azizz/besm6.github.io/sources/dubna/besml21/               *
C*       libra211.l21:15448-15528  — исходник версии 4.13 (Dubna)         *
C*   S2  dispak/tests/forex/output.txt:32-36,59 — версия 2.02,            *
C*       FOREX* загружается по 0o1770, оверлеи по 0o22654                  *
C*   S3  monsys.9, слова 0o510300-0o510347 — скомпилированный корень      *
C*       (даёт адреса констант и код LOREX/RMON)                           *
C*   S4  expect_library21.txt:182,196-205 — LIBREFER (внешние связи)      *
C*                                                                        *
C*  АДРЕСА: левая колонка — адрес скомпилированного слова на ленте        *
C*  monsys.9 (S3); «внутренние» адреса 0o4xxx — адреса данных в поле       *
C*  загрузки модуля (FOREX* грузится по 0o1770, S2).                       *
C*  ТОЧНОСТЬ: адреса LOREX (0o510315-16), RMON (0o510317-31), STOP/        *
C*  (0o510332-33) и данных (0o510334-47) подтверждены поразрядным          *
C*  совпадением с дизассемблом S3; адреса INITFOR* (?0o510303-14)          *
C*  приблизительны — сборка 2.02 отличается от исходника 4.13.            *
C***********************************************************************

C ---- КОНСТАНТЫ/ЛИТЕРАЛЫ (все операндные литералы -> ,EQU,) ----
BASE_REG14               ,EQU, 14                           ; роль: номер индексного регистра базы M14; источник: S1:15474
BUFFER_A_LEN             ,EQU, 4000B                        ; роль: COMMON *A*: 2048 слов; источник: S1:15465
DEC_15                   ,EQU, 15                           ; роль: ; S1:16796; источник: S1:16796
DUMON_LEN                ,EQU, 5                            ; роль: COMMON *DUMON*: 5 слов; источник: S1:15454
ENTRY_TAB_LEN            ,EQU, 50B                          ; роль: COMMON ENTRY*: 40 слов; источник: S1:15449
ERR_TRANSLATOR_TEXT      ,EQU, 18H'200'0OШ. TPAHCЛЯTOPA'231' ; роль: сообщение «ОШ. ТРАНСЛЯТОРА»; источник: FOREX_ROOT.mad:112
FIXED_MODE_2             ,EQU, 2                            ; роль: режим NTR 2 / шаг 2; источник: S1:16801
GOST_V                   ,EQU, 1H'212'                      ; роль: GOST-код «В»; источник: S1:15520
GOST_VREMYA              ,EQU, 6HBPEMЯ-                     ; роль: GOST «ВРЕМЯ-»; источник: S1:15521
GOST_YA                  ,EQU, 1H'231'                      ; роль: GOST-код «Я»; источник: S1:15523
MODE_6                   ,EQU, 6                            ; роль: режим NTR 6; источник: S1:15469
MODE_RT_OCT22_DEC        ,EQU, 18                           ; роль: NTR 18 (десятичное) = 22 восьмеричное — реальное время; источник: S1:15491
ONE_WORD                 ,EQU, 1                            ; роль: одно слово / константа 1; источник: S1:15450
PAGE17_ADDR              ,EQU, 17B                          ; роль: адрес 17B в механизме страниц; источник: S1:16807
PAGE_MODE_73401          ,EQU, =73401                       ; роль: режим/маска страницы 73401; источник: S1:16789
PG_BLOCK_MASK            ,EQU, =4000                        ; роль: маска блока страницы =4000; источник: S1:16827
PG_EX67_CODE             ,EQU, =:11 4037 77                 ; роль: код экстракода 67; источник: S1:16793
PG_FLAG_SHIFT            ,EQU, 64+12                        ; роль: выделение флага страницы; источник: S1:16790
PG_GO_CODE_1             ,EQU, =:00 2677                    ; роль: код перехода GO; источник: S1:16829
PG_GO_CODE_2             ,EQU, =:00 6736 77                 ; роль: код перехода GO (вариант); источник: S1:16830
PG_WORD_SHIFT            ,EQU, 64-20                        ; роль: выделение слова адреса страницы; источник: S1:16798
PRINT_BLOCK_LEN          ,EQU, 002                          ; роль: длина блока описания печати INF; источник: S1:15518
REAL_MODE_3              ,EQU, 3                            ; роль: режим NTR 3 (вещественный); источник: S1:15495
RET_LINK_REG             ,EQU, 13                           ; роль: номер индексного регистра связывания M13; источник: S1:15467
RM_WORDS_4               ,EQU, 4                            ; роль: COMMON RM*: 4 слова; источник: S1:16786
STACK_OFF_M2             ,EQU, -2                           ; роль: ; (COMM) ; S1:16800 M14 = -2 (счётчик); источник: S1:16800
TEXT_LO_GEN              ,EQU, 8HLO*GEN                     ; роль: TEXT-имя оверлея LO*GEN; источник: S1:15526
TEXT_LO_SYN              ,EQU, 8HLO*SYN                     ; роль: TEXT-имя оверлея LO*SYN; источник: S1:15525
TIME_SCALE               ,EQU, =R100.0                      ; роль: масштаб пересчёта времени в секунды; источник: S1:15494
TIME_SEP_A               ,EQU, =6H'''17''17''17''17''17'    ; роль: разделители времени (S1:15499); источник: S1:15499
TIME_SEP_B               ,EQU, =6H'17''17''17''''17''17'    ; роль: разделители времени (S1:15500); источник: S1:15500
TIME_SEP_C               ,EQU, =6H'''''''16'''''            ; роль: разделители времени (S1:15501); источник: S1:15501
LINK_REG_15            ,EQU, 15                         ; роль: номер регистра связывания M15; источник: S1:16796,16826
PG_STEP_2              ,EQU, 2                          ; роль: шаг обхода INFLOA в PG_COPY_LOOP; источник: S1:16801,16804
C ---- конец блока констант ----

