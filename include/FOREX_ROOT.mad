C----- 0o510315  LOAD_OVERLAYS (LOREX): загрузка оверлеев ---------------------------------
C  XTS помещает в аккумулятор адрес TEXT-константы; LOADANGO читает по
C  этому адресу пару «имя (TEXT), дескриптор» и грузит оверлей по 0o22654.
C  В скомпилированном корне константы находятся по адресам 0o4031/0o4032
C  (физические слова ленты 0o510345/0o510346, см. ниже).
  LOAD_OVERLAYS:,ENTRY,.              ; (LOREX)                   ; S1:15485  ENTRY
  0o510315  ,XTS,LO*SYN            ; S1:15486  acc <- адрес LO*SYN = 0o4031
  0o510315  ,CALL,LOADANGO.        ; S1:15487  vjm 74022(15) -> LOADANGO
  0o510316  ,XTS,LO*GEN            ; S1:15488  acc <- адрес LO*GEN = 0o4032
  0o510316  ,CALL,LOADANGO.        ; S1:15489  vjm 74022(15) -> LOADANGO

