   FXLODR:,BSS,.
C === F3a: REAL FXLODR, LOCAL CALLEE, ZERO EXTERNAL SUBP ===================
C Вход : acc = адрес TEXT-имени LO*SYN (0o4031) / LO*GEN (0o4032).
C Вызов: 13,VJM,FXLODR (M13 = адрес возврата в LOREX).
C Возврат: 13,UJ, с восстановленным M13.
C
C ФАКТ (проба run_ram): PERSO-образ с каталогом Присутствует в ОЗУ задачи:
C   сканирование слова HEADER_WORD=0o2105000 в диапазоне 0o20000..0o60000
C   нашло его, после чего цикл копии 1024 слова выполнился и напечатал
C   'F3 COPY OK'. Значит CATALOG доступен по прямому чтению, без *70/барабана.
C ГИПОТЕЗА: смещения тел в образе фиксированы сборщиком
C   (tools/build_forex_perso.py:349-371): BODYSYN=2464, BODYGEN=3520
C   (десятичные номера слов build/FOREX_INLINE.bin, 0o4640/0o6700).
C   Если каталог окажется another image, поправить F3SYN/F3GEN.
C
C 0. Сохранить имя и M13 (scratch: M6/M7/M9/M10/M12).
   ,ATX,FXNAME
   ,ITA,14
   ,ATI,17
   ,ITA,13.
   ,ATX,FXSAVE
C 1. Взять 8-символьное TEXT-слово по адресу из acc.
   ,XTA,FXNAME
   ,XTA,
   ,ATX,FXPAT
C 2. Найти заголовок PERSO-каталога в ОЗУ (0o2105000).
   ,XTA,=20000
   ,ATI,6
   ,XTA,=40000
   ,ATI,9
   F3SCAN: 6,XTA,
   ,AEX,=2105000
   ,UZA,F3HDR
   6,UTM,1
   9,UTM,-1
   9,V1M,F3SCAN
   ,UJ,F3DONE
C 3. Обход пар (name,record) со слова CATBASE+2; terminator name=0.
C    Шаблон: monitor80-re/utility/overlay.asm:299-302.
   F3HDR: ,ITA,6
   ,ATI,10
   ,ITA,10
   ,ATI,12
   12,UTM,2
   F3SCAN2: 12,XTA,
   ,UZA,F3DONE
   ,AEX,FXPAT
   ,UZA,F3MATCH
   12,UTM,2
   ,UJ,F3SCAN2
C 4. Имя совпало -> выбрать смещение тела по имени.
   F3MATCH: ,XTA,FXPAT
   ,AEX,=5457126371560000
   ,UZA,F3ISGEN
   ,XTA,=5040
   ,UJ,F3COPY
   F3ISGEN: ,XTA,=7100
   F3COPY: ,ATX,F3OFF
C    Источник = CATBASE + offset (M10 = CATBASE).
   ,ITA,10
   ,A+X,F3OFF
   ,ATI,6
C 5. Приёмник 0o22654, счётчик 1024 (0o2000), копия (overlay.asm:323-328).
   ,XTA,=22654
   ,ATI,7
   ,XTA,=2000
   ,ATI,9
   F3CP: 6,XTA,
   7,ATX,
   6,UTM,1
   7,UTM,1
   9,UTM,-1
   9,V1M,F3CP
C 6. База M1 (SYN) / M7 (GEN) из слова DEST+4 (документированная
C    альтернатива: база = адрес загруженного тела 0o22654; точное
C    значение слова +4 статически не выводится).
   ,XTA,FXPAT
   ,AEX,=5457126371560000
   ,UZA,F3BASE7
   ,XTA,=22654
   ,ATI,1
   ,UJ,F3DONE
   F3BASE7: ,XTA,=22654
   ,ATI,7
C 7. Восстановить M13 и вернуться.
   F3DONE: ,ITA,17
   ,ATI,14
   ,XTA,FXSAVE
   ,ATI,13
   13,UJ,.
C ---- Данные ----
   FXNAME:,BSS,1.
   FXSAVE:,BSS,1.
   FXPAT:,BSS,1.
   F3OFF:,BSS,1.
   ,END,