C  VERSION STAMP FOREX 5.00 / 19.11.2026 (re-forex); host banner 2.02 is external
C***********************************************************************
C* FOREX_RUNTIME_DISASM — ДИЗАССЕМБЛИРОВАННЫЕ (НЕ ПЕРЕПИСАННЫЕ!) ТЕЛА       *
C* скомпилированных рантайм-модулей FORMAT и FORTLIBR компилятора ФОРЭКС.  *
C*                                                                       *
C* МЕТОД (в отличие от src/FOREX_RUNTIME.mad — там дословный листинг):    *
C*  1. Тела найдены В ДВОИЧНОМ ВИДЕ на ленте monsys.9:                     *
C*       FORMAT   : 0o510443-0o510537, 61 слово  (код + имя + таблицы)     *
C*       FORTLIBR : 0o510543-0o510647, 69 слов   (код + константы + ISO)   *
C*  2. Сырые слова выгружены в build/RUNTIME_FORMAT.words /                *
C*     build/RUNTIME_FORTLIBR.words (6 байт/слово, big-endian).            *
C*  3. Дизассемблирование:                                                 *
C*       tools/dtran_wrap.py  -> disasm/RUNTIME_*.madlen                   *
C*       besm6tape.py dis --bemsh -> disasm/RUNTIME_*.bemsh.lst            *
C*  4. Каждое машинное слово помечено «С слово NNNN @0o... = 0o...» —       *
C*     это побайтовая проверка против дампа (см. конец файла).              *
C*                                                                       *
C* ИСТОЧНИКИ ДЛЯ СВЕРКИ СМЫСЛА:                                            *
C*   reference/libra211.format.inc:19-79   (FORMAT,  S1:15529-15589)       *
C*   reference/libra211.format.inc:80-202  (FORTLIBR, S1:15590-15712)      *
C*   include/FOREX_RUNTIME.xref.md, include/FOREX_RUNTIME.registers.md     *
C*                                                                       *
C* ПРАВИЛО ИМЕН (критично для МАДЛЕН — различаются только ПЕРВЫЕ 6 ЗНАКОВ):*
C*   все метки и все ,EQU, имена имеют длину <= 6 и уникальны первыми       *
C*   6 знаками. Полное смысловое имя даётся в комментарии «; (полное: ...)»*
C*   и в include/RUNTIME_DISASM.xref.md.                                   *
C***********************************************************************

C ---- КОНСТАНТЫ: ВСЕ литералы вынесены в ,EQU, (имя <= 6 знаков) ----
C  Общие BASE/register-константы
BAS14           ,EQU, 14                ; (полное: BASE_REG14); роль: номер индексного регистра базы таблицы передач M14; S1:15541
LNK13           ,EQU, 13                ; (полное: RET_LINK_REG); роль: номер регистра связывания M13; S1:15597
WRK07           ,EQU, 7                 ; (полное: WORK_REG7); роль: рабочий регистр FORTLIBR M7; S1:15596
C  FORMAT: маски и база таблицы передач
FTADR           ,EQU, 103B              ; (полное: FT_ADDR_FIELD); роль: маска поля адреса при выборке дескриптора TRANSFER; S1:15543
FTOFSM          ,EQU, 155B              ; (полное: FT_OFFSET_MASK); роль: маска смещения в таблице передач; S1:15559
FTBTAB          ,EQU, 77766B            ; (полное: FTD_TABLE_BASE_ADDR); роль: база таблицы передач FORMAT; S1:15549
FTLOG           ,EQU, 10000000 00000000 ; (полное: FTD_CONST); роль: константа сложения при расчёте смещения; S1:15587
C  FORMAT: внешние ячейки передачи (адреса 77xxxB в исходнике)
D571DS          ,EQU, 77207B            ; (полное: FT571_DISPATCH); роль: ячейка передачи FT*571 (импорт из ANL); S1:15566 / S3:1075
D541DS          ,EQU, 77237B            ; (полное: FT541_DISPATCH); роль: ячейка передачи FT*541; S1:15568
D611DS          ,EQU, 77167B            ; (полное: FT611_DISPATCH); роль: ячейка передачи FT*611; S1:15570
D531DS          ,EQU, 77247B            ; (полное: FT531_DISPATCH); роль: ячейка передачи FT*531; S1:15572
D561DS          ,EQU, 77217B            ; (полное: FT561_DISPATCH); роль: ячейка передачи FT*561; S1:15574
D621DS          ,EQU, 77157B            ; (полное: FT621_DISPATCH); роль: ячейка передачи FT*621; S1:15576
D521DS          ,EQU, 77257B            ; (полное: FT521_DISPATCH); роль: ячейка передачи FT*521; S1:15578
D721DS          ,EQU, 77057B            ; (полное: FT721_DISPATCH); роль: ячейка передачи FT*721; S1:15580
D641DS          ,EQU, 77137B            ; (полное: FT641_DISPATCH); роль: ячейка передачи FT*641; S1:15582
D002DS          ,EQU, 77776B            ; (полное: FT002_DISPATCH); роль: ячейка передачи FT*002; S1:15584
D003DS          ,EQU, 77775B            ; (полное: FT003_DISPATCH); роль: ячейка передачи FT*003; S1:15586
C  FORMAT: адреса LINK-ячеек внешних подпрограмм (старшее поле 740xx)
X01             ,EQU, 74001B            ; (полное: EXT_LINK_FT571); роль: LINK-адрес FT*571; лента 0o510457
X02             ,EQU, 74002B            ; (полное: EXT_LINK_FT541); роль: LINK-адрес FT*541; лента 0o510460
X03             ,EQU, 74003B            ; (полное: EXT_LINK_FT611); роль: LINK-адрес FT*611; лента 0o510461
X04             ,EQU, 74004B            ; (полное: EXT_LINK_FT531); роль: LINK-адрес FT*531; лента 0o510462
X05             ,EQU, 74005B            ; (полное: EXT_LINK_FT561); роль: LINK-адрес FT*561; лента 0o510463
X06             ,EQU, 74006B            ; (полное: EXT_LINK_FT621); роль: LINK-адрес FT*621; лента 0o510464
X07             ,EQU, 74007B            ; (полное: EXT_LINK_FT521); роль: LINK-адрес FT*521; лента 0o510465
X10             ,EQU, 74010B            ; (полное: EXT_LINK_FT721); роль: LINK-адрес FT*721; лента 0o510466
X11             ,EQU, 74011B            ; (полное: EXT_LINK_FT641); роль: LINK-адрес FT*641; лента 0o510467
X12             ,EQU, 74012B            ; (полное: EXT_LINK_FT002); роль: LINK-адрес FT*002; лента 0o510470
X13             ,EQU, 74013B            ; (полное: EXT_LINK_FT003); роль: LINK-адрес FT*003; лента 0o510471
C  FORTLIBR: литералы кода
ZERO            ,EQU, 0                 ; (полное: ZERO); роль: нулевая константа / признак «нет знака»; S1:15691
ONE             ,EQU, 1                 ; (полное: ONE_WORD); роль: единица — приращение/счётчик; S1:15646
TWO             ,EQU, 2                 ; (полное: TWO); роль: двойка — счётчик разрядов; S1:15703
TRIO            ,EQU, 3                 ; (полное: REAL_MODE_3); роль: режим NTR 3 / константа 3; S1:15612
SEVEN           ,EQU, 7                 ; (полное: DEC_7); роль: счётчик Cycles PRINT8; S1:15596
M1777           ,EQU, 1777B             ; (полное: MASK_1777); роль: маска 1777B в константе *00066; S1:15696
ISOHI           ,EQU, 10000000 00000000 ; (полное: HIGH_BIT_ISO); роль: старший бит для сборки ISO-кода цифры; S1:15697
MSK73           ,EQU, 37777774 77777477 ; (полное: SIGN_EXP_MASK); роль: маска знака/порядка числа; S1:15701
MSK76           ,EQU, 77270707 00000000 ; (полное: EXTRACT_MASK); роль: маска экстракода *70; S1:15704
ISOSHF          ,EQU, 54B               ; (полное: ISO_CODE_SHIFT); роль: сдвиг ASN 54B при сборке 8-символьного слова; S1:15685
ALL1            ,EQU, 77777B            ; (полное: ALL_ONES_MASK); роль: маска «все единицы» (XTA 77777B); S1:15677
LIBBUF          ,EQU, 2000B             ; (полное: LIB_BUFFER_LEN); роль: длина BUFFER — 0o2000 слов; S1:15591
C ---- конец блока констант ----
