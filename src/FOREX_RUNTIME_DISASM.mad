C----- 1. FORMAT (FT_FORMAT_DISPATCH): скомпилированный диспетчер FT* -----
C  Адрес 0o510443, 61 слово. Исходник: reference/libra211.format.inc:19-79.
C  Модуль НЕ форматирует данные: он заполняет 11 ячеек передачи 77xxxB
C  адресами подпрограмм FT* (S3:206-216). Ниже — МАШИННЫЙ код, а не листинг.
C  Внешние адреса 74001..74013 — LINK-ячейки, помечены X01..X13.
FMTENT: ,ATI,BAS14        . S1:15541 M14 := acc — база таблицы передач
        14,XTA,            . S1:15542 acc := (M14) — взять слово дескриптора
        ,ASN,FTADR        . S1:15543 ASN 103B — выделить поле адреса
        ,YTA,              . S1:15544 YTA — переписать в индексный регистр
        ,UTC,FTLOG        . S1:15545 UTC FTD_CONST — сложить константу
        ,AEX,              . S1:15546 AEX — поменять A и X местами
        ,U1A,FMT010       . S1:15547 UIA *00010 — переход к расчёту смещения
        14,XTA,            . S1:15548 14 XTA — повторная выборка базы
 FMT004:12,VTM,FTBTAB . S1:15549 12 VTM 77766B — база таблицы передач
 FMT005:,ATI,BAS14  . S1:15551 ATI 14 — счётчик цикла
        12,WTC,FMT026     . S1:15552 12 WTC *00026 — модификатор адреса
        14,UTM,            . S1:15553 14 UTM — декремент M14
        14,VZM,FMT012     . S1:15554 14 VZM *00012 — выход при нуле
        12,VLM,FMT005     . S1:15555 12 VLM *00005 — цикл по M12
        ,IJ,               . S1:15556 IJ — возврат из цикла
 FMT010: ,UTC,FTLOG       . S1:15557 UTC *00027
        ,AEX,              . S1:15558 AEX
        ,ASN,FTOFSM       . S1:15559 ASN 155B — маска смещения
        ,UJ,FMT004        . S1:15560 UJ *00004
 FMT012: ,STX,             . S1:15561 STX — записать адрес FT* в ячейку
        ,ATI,BAS14        . S1:15562 ATI 14 — продвинуть указатель
        12,UJ,FMT026      . S1:15563 12 UJ *00026
        ,UTC,              . S1:15564 UTC
 FMTTAB: ,UJ,X01          . S1:15565 UJ FT*571 -> LINK 0o74001 (внешний!)
        ,ATX,D571DS       . S1:15566 ATX 77207B — ячейка приёма FT*571
        ,UJ,X02          . S1:15567 UJ FT*541 -> LINK 0o74002 (внешний!)
        ,ATX,D541DS       . S1:15568 ATX 77237B
        ,UJ,X03          . S1:15569 UJ FT*611 -> LINK 0o74003 (внешний!)
        ,ATX,D611DS       . S1:15570 ATX 77167B
        ,UJ,X04          . S1:15571 UJ FT*531 -> LINK 0o74004 (внешний!)
        ,ATX,D531DS       . S1:15572 ATX 77247B
        ,UJ,X05          . S1:15573 UJ FT*561 -> LINK 0o74005 (внешний!)
        ,ATX,D561DS       . S1:15574 ATX 77217B
        ,UJ,X06          . S1:15575 UJ FT*621 -> LINK 0o74006 (внешний!)
        ,ATX,D621DS       . S1:15576 ATX 77157B
        ,UJ,X07          . S1:15577 UJ FT*521 -> LINK 0o74007 (внешний!)
        ,ATX,D521DS       . S1:15578 ATX 77257B
        ,UJ,X10          . S1:15579 UJ FT*721 -> LINK 0o74010 (внешний!)
        ,ATX,D721DS       . S1:15580 ATX 77057B
        ,UJ,X11          . S1:15581 UJ FT*641 -> LINK 0o74011 (внешний!)
        ,ATX,D641DS       . S1:15582 ATX 77137B
        ,UJ,X12          . S1:15583 UJ FT*002 -> LINK 0o74012 (внешний!)
        ,ATX,D002DS       . S1:15584 ATX 77776B
 FMT026: ,UJ,X13          . S1:15585 UJ FT*003 -> LINK 0o74013 (внешний!)
        ,ATX,D003DS       . S1:15586 ATX 77775B
 FMTLST: ,ATX,            . Слово 0o510472 — конец кода / выравнивание
C  Служебный хвост модуля (НЕ исходный МАДЛЕН, а объектная обвязка):
 FMTNAM: ,ATX,            . 0o510473 — t6-имя модуля 'FORMAT  '
 FMTXLT: ,ATX,            . 0o510474-0o510506 — 11 адресов ячеек передачи (4030..4042)
 FMTCST: ,ATX,            . 0o510507-0o510522 — 12 младших 12 бит адресов 77xxxB
 FMTXNM: ,ATX,            . 0o510523-0o510535 — t6-имена FT*571 … FT*003
 FMTEND: ,ATX,            . 0o510536-0o510537 — END-маркер библиотеки ('GFEDCBA+')
