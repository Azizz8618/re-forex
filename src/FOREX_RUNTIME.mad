C----- 1. FTDISP (FORMAT): диспетчер таблицы входов FT* (S1:15529-15589) -----
C  Модуль не форматирует данные сам: он строит таблицу передач,
C  записывая адреса 11 подпрограмм FT* в ячейки 77xxxB (S3:206-216).
      FTDISP     :,NAME,  ; (FORMAT)        ; S1:15529  ; полное имя: FT_FORMAT_DISPATCH
C  Объявлены 11 внешних подпрограмм: FT*571 … FT*003.
      FT*571     :,SUBP,        ; S1:15530
      FT*541     :,SUBP,        ; S1:15531
      FT*611     :,SUBP,        ; S1:15532
      FT*531     :,SUBP,        ; S1:15533
      FT*561     :,SUBP,        ; S1:15534
      FT*621     :,SUBP,        ; S1:15535
      FT*521     :,SUBP,        ; S1:15536
      FT*721     :,SUBP,        ; S1:15537
      FT*641     :,SUBP,        ; S1:15538
      FT*002     :,SUBP,        ; S1:15539
      FT*003     :,SUBP,        ; S1:15540
C  Настройка M14 и вычисление смещения в таблице передач.
                 ,ATI,  BS14R        ; S1:15541  M14 <- acc: установка индексного регистра
            14 ,  XTA,        ; S1:15542  acc <- (M14)
                 ,ASN,  FTADFL        ; S1:15543  ASN 103B: выделение поля адреса
                 ,YTA,        ; S1:15544
                 ,UTC,   FTDCNS        ; S1:15545  UTC FTDCNS: прибавить константу
                 ,AEX,        ; S1:15546
                 ,UIA,   FTDOFS        ; S1:15547
            14 ,  XTA,        ; S1:15548
C  M12 = база 77766B; цикл VLM по M12 обходит таблицу.
 FTDTSB    :12 ,  VTM,  FTDTBA        ; S1:15549  M12 <- база 77766B  ; полное имя: FTD_TABLE_BASE
                 ,UTC,        ; S1:15550
 FTDLOP    :     ,ATI,  BS14R        ; S1:15551  ; полное имя: FTD_LOOP
            12 ,  WTC,   FTDTE        ; S1:15552  WTC FTDTE: модификатор адреса
            14 ,  UTM,        ; S1:15553
            14 ,  VZM,   FTDSTO        ; S1:15554  VZM FTDSTO: переход при нулевом M14
            12 ,  VLM,   FTDLOP        ; S1:15555  VLM FTDLOP: цикл по M12
                 , IJ,        ; S1:15556
C  Вычисление адреса очередной пары «UJ FT* / ATX 77xxxB».
 FTDOFS    :     ,UTC,   FTDCNS        ; S1:15557  формирование смещения (ASN 155B)  ; полное имя: FTD_OFFSET
                 ,AEX,        ; S1:15558
                 ,ASN,  FTOFMK        ; S1:15559
                 , UJ,   FTDTSB        ; S1:15560
C  STX + ATI 14: запись и продвижение указателя таблицы.
 FTDSTO    :     ,STX,        ; S1:15561  ; полное имя: FTD_STORE
                 ,ATI,  BS14R        ; S1:15562
            12 ,   UJ,   FTDTE        ; S1:15563
                 ,UTC,        ; S1:15564
C  ТАБЛИЦА ПЕРЕХОДОВ: 11 пар UJ FT*nnn / ATX 77xxxB.
C  FT*571 реально экспортирует ANL (S3:1075), остальные 10 — FORMAT.
                 , UJ,  FT*571        ; S1:15565  FT*571 -> 77207B (импорт из ANL)
                 ,ATX,  F571DS        ; S1:15566
                 , UJ,  FT*541        ; S1:15567  FT*541 -> 77237B
                 ,ATX,  F541DS        ; S1:15568
                 , UJ,  FT*611        ; S1:15569  FT*611 -> 77167B
                 ,ATX,  F611DS        ; S1:15570
                 , UJ,  FT*531        ; S1:15571  FT*531 -> 77247B
                 ,ATX,  F531DS        ; S1:15572
                 , UJ,  FT*561        ; S1:15573  FT*561 -> 77217B
                 ,ATX,  F561DS        ; S1:15574
                 , UJ,  FT*621        ; S1:15575  FT*621 -> 77157B
                 ,ATX,  F621DS        ; S1:15576
                 , UJ,  FT*521        ; S1:15577  FT*521 -> 77257B
                 ,ATX,  F521DS        ; S1:15578
                 , UJ,  FT*721        ; S1:15579  FT*721 -> 77057B
                 ,ATX,  F721DS        ; S1:15580
                 , UJ,  FT*641        ; S1:15581  FT*641 -> 77137B
                 ,ATX,  F641DS        ; S1:15582
                 , UJ,  FT*002        ; S1:15583  FT*002 -> 77776B
                 ,ATX,  F002DS        ; S1:15584
 FTDTE    :     , UJ,  FT*003        ; S1:15585  FT*003 -> 77775B  ; полное имя: FTD_TABLE_END
                 ,ATX,  F003DS        ; S1:15586
C  Константы и конец модуля.
 FTDCNS    :,     LOG,  LIT10M.        ; S1:15587  FTDCNS: LOG 10000000 00000000  . полное имя: FTD_CONST
 BSS       :     ,BSS,        ; S1:15588
      ,END,        ; S1:15589  END FORMAT

C----- 2. FTLIO (FORTLIBR): PRINT8 / WRTLBR (S1:15590-15712) -----
C  Экспорт: PRINT8 (S3:217), WRTLBR (S3:1313).
C  FTLBFR PU 2000B — буфер обмена с библиотекой.
      FTLIO   :,NAME,  ; (FORTLIBR)        ; S1:15590  ; полное имя: FT_LIBRARY_IO
      FTLBFR     :,PU,  LIBBLN        ; S1:15591  FTLBFR: PU 2000B (0o2000 слов)  ; полное имя: FT_LIB_BUFFER
      WRTLBR   :,SUBP,        ; S1:15592  SUBP — точка входа (экспорт)  ; полное имя: WRITLIBR
      PRINT8     :,SUBP,        ; S1:15593  SUBP — точка входа (экспорт)
C  PRINT8: печать 8-символьного ISO-слова; M14/M7/M13 — рабочие.
            14 ,  VTM,   FLCON        ; S1:15594  M14 <- FLCON (база констант)
L           14 ,  ATX,   *00077    - FLCON        ; S1:15595
                 ,ITA,  DEC_7        ; S1:15596
                 ,ITS,  RETLR        ; S1:15597
             7 ,  VTM,   FLCON        ; S1:15598
L            7 ,  XTS,   *00064    - FLCON        ; S1:15599
L            7 ,  ATX,   *00100    - FLCON        ; S1:15600
            14 ,  VTM,   *00014        ; S1:15601
                 ,ITA,  BS14R        ; S1:15602
C  VJM WRTLBR+1 — вызов подготовительной части WRTLBR.
L           13 ,  VJM,   WRTLBR  +1        ; S1:15603  VJM WRTLBR+1
                 ,UIA,   FLAFT        ; S1:15604
                 ,STI,        ; S1:15605
                 ,STI,  RETLR        ; S1:15606
                 ,STI,  DEC_7        ; S1:15607
            13 ,   UJ,        ; S1:15608
                 ,UTC,        ; S1:15609
 FLAFT    :14 ,  VTM,   *00101        ; S1:15610  ; полное имя: FL_AFTER_WRITE
                 ,ITS,  BS14R        ; S1:15611
            14 ,  UTM,  RMOD3        ; S1:15612
                 ,ITS,  BS14R        ; S1:15613
                 ,ITS,        ; S1:15614
C  VJM PRINT8 — печать подготовленного слова.
            13 ,  VJM,  PRINT8        ; S1:15615  VJM PRINT8
                 , *74,        ; S1:15616
C  WRTLBR: проверки и сборка выходного слова в FTLBFR.
 *00014    :     ,ITS,  DEC_7        ; S1:15617
             7 ,  VTM,   FLCON        ; S1:15618
             7 ,  ATX,        ; S1:15619
C  M14 = FTLBFR: адрес буфера.
            14 ,  VTM,  FTLBFR        ; S1:15620  M14 <- FTLBFR
                 ,ITA,  BS14R        ; S1:15621
L            7 ,  ATX,   *00071    - FLCON        ; S1:15622
                 ,UTC,   *00100        ; S1:15623
                 ,XTA,        ; S1:15624
                 ,UZA,   FL_SIGN_CHECK        ; S1:15625
L            7 ,  ATX,   *00062    - FLCON        ; S1:15626
                 ,XTA,        ; S1:15627
L            7 ,  ATX,   *00063    - FLCON        ; S1:15628
                 ,UTC,   *00100        ; S1:15629
                 ,ATX,        ; S1:15630
FLSIGC    : 7 ,  XTA,   *00062    - FLCON        ; S1:15631  ; POLN: FL_SIGN_CHECK_62, проверка знака/разряда (было L00023 / L*00023)
                 ,UZA,   FL_COMPARE        ; S1:15632
L            7 ,  XTA,   *00063    - FLCON        ; S1:15633
                 ,UIA,   FLWTC        ; S1:15634
C  WTC *00077 — установка модификатора адреса.
                 ,WTC,   *00077        ; S1:15635  WTC *00077
                 ,XTA,        ; S1:15636
                 ,AEX,        ; S1:15637
                 ,UZA,   FLALT        ; S1:15638
FLXORL    : 7 ,  XTS,   *00063    - FLCON        ; S1:15639  ; POLN: FL_XOR_LOOP_63, цикл AEX/сборки выходного слова (было L00027 / L*00027)
L            7 ,  AEX,   *00064    - FLCON        ; S1:15640
L            7 ,  STX,   *00063    - FLCON        ; S1:15641
             7 ,  XTS,        ; S1:15642
                 ,STI,  DEC_7        ; S1:15643
            13 ,   UJ,        ; S1:15644
 FLWTC    :     ,WTC,   *00077        ; S1:15645  ; полное имя: FL_WTC_CASE
                 ,XTA,  ONEW        ; S1:15646
L            7 ,  XTS,   *00077    - FLCON        ; S1:15647
L            7 ,  ARX,   *00075    - FLCON        ; S1:15648
L            7 ,  ATX,   *00077    - FLCON        ; S1:15649
                 ,STX,        ; S1:15650
                 , UJ,   FL_XOR_LOOP        ; S1:15651
                 ,UTC,        ; S1:15652
 FLALT    :     ,WTC,   *00077        ; S1:15653  ; полное имя: FL_ALT_CASE
                 ,XTA,  ONEW        ; S1:15654
L            7 ,  ATX,   *00065    - FLCON        ; S1:15655
                 ,XTA,        ; S1:15656
L            7 ,  ATX,   *00062    - FLCON        ; S1:15657
L            7 ,  ATX,   *00072    - FLCON        ; S1:15658
L            7 ,  ATX,   *00074    - FLCON        ; S1:15659
                 , UJ,   FL_COMPARE        ; S1:15660
FLSHIN    : 7 ,  ARX,   *00071    - FLCON        ; S1:15661  ; POLN: FL_SHIFT_IN_71, сдвиг и подстановка разрядов (было L00042 / L*00042)
L            7 ,  ATX,   *00072    - FLCON        ; S1:15662
L            7 ,  XTA,   *00074    - FLCON        ; S1:15663
L            7 ,  ARX,   *00064    - FLCON        ; S1:15664
L            7 ,  ATX,   *00074    - FLCON        ; S1:15665
                 ,UTC,        ; S1:15666
FLCMPR    : 7 ,  XTA,   *00072    - FLCON        ; S1:15667  ; POLN: FL_COMPARE_72, сравнение и проверка маски (было L00045 / L*00045)
L            7 ,  AEX,   *00071    - FLCON        ; S1:15668
                 ,UZA,   FL_MASK_CASE        ; S1:15669
L            7 ,  AAX,   *00066    - FLCON        ; S1:15670
                 ,UZA,   FL_ASSEMBLE        ; S1:15671
                 ,UTC,        ; S1:15672
FLMASK    : 7 ,  XTA,   *00072    - FLCON        ; S1:15673  ; POLN: FL_MASK_ALL_72, ветка маскирования 77777B (было L00050 / L*00050)
L            7 ,  ARX,   *00064    - FLCON        ; S1:15674
L            7 ,  ATX,   *00072    - FLCON        ; S1:15675
                 ,WTC,   *00072        ; S1:15676
                 ,XTA,  ALLMS        ; S1:15677  XTA 77777B — маска
                 , UJ,   FL_XOR_LOOP        ; S1:15678
FLASMB    : 7 ,  XTA,   *00065    - FLCON        ; S1:15679  ; POLN: FL_ASSEMBLE_65, сборка 8-символьного ISO-слова (было L00053 / L*00053)
L            7 ,  ARX,   *00074    - FLCON        ; S1:15680
L            7 ,  AAX,   *00073    - FLCON        ; S1:15681
L            7 ,  AOX,   *00067    - FLCON        ; S1:15682
L            7 ,  ATX,   *00070    - FLCON        ; S1:15683
C  Экстракод *70 = Memory/register dump [Besm6_Instruction_Set.md §6] — дамп памяти/регистров; информационное слово — адрес/объём дампа (конкретное слово не найдено ни в rukava.be, ни в Тюрине-1985); и сдвиг ASN 54B — сборка 8-символьного слова.
L            7 ,  XTS,   *00071    - FLCON        ; S1:15684  ASN 54B
                 ,ASN,  ISOCSH        ; S1:15685
            15 ,  AOX,        ; S1:15686
L            7 ,  ATX,   *00070    - FLCON        ; S1:15687
L            7 ,   *70,  *00070    - FLCON        ; S1:15688  Э70 = Memory/register dump [Besm6_Instruction_Set.md §6]; информационное слово *00070 — адрес/объём дампа (контекст); конкретное слово не найдено ни в rukava.be, ни в Тюрине-1985
                 ,XTA,        ; S1:15689
                 , UJ,   FL_SHIFT_IN        ; S1:15690
 FLCON    :,     LOG,  DW0001.        ; S1:15691  . полное имя: FL_CONST_BASE
 *00062    :,     LOG,  DW0001.        ; S1:15692
 *00063    :,     LOG,  DW0001.        ; S1:15693
 *00064    :,     LOG,  DW0002.        ; S1:15694
 *00065    :,     LOG,  DW0001.        ; S1:15695
 *00066    :,     LOG,  DW0004.        ; S1:15696
 *00067    :,     LOG,  DW0005.        ; S1:15697
 *00070    :,     LOG,  DW0001.        ; S1:15698
 *00071    :,     LOG,  DW0001.        ; S1:15699
 *00072    :,     LOG,  DW0001.        ; S1:15700
 *00073    :,     LOG,  DW0007.        ; S1:15701
 *00074    :,     LOG,  DW0001.        ; S1:15702
 *00075    :,     LOG,  DW0003.        ; S1:15703
            ,     LOG,  DW0008.        ; S1:15704
 *00077    :,     LOG,  DW0001.        ; S1:15705
 *00100    :,     LOG,  DW0001.        ; S1:15706
C  Диагностика «ERROR IN STANDARD ARRAY».
 *00101    :, ISO    ,TL0013        ; S1:15707
            , ISO    ,TL0014        ; S1:15708
            , ISO    ,TL0015        ; S1:15709
            , ISO    ,TL0011        ; S1:15710
C  Конец FORTLIBR.
 BSS       :     ,BSS,        ; S1:15711  BSS
      ,END,        ; S1:15712  END FORTLIBR

C----- 3. DATAPR (DATAPR): печать даты DD MON YY HH.MM (S5:7645-7733) -----
C  Резидент MONSYS; вызывается корнем INITFOR* (S1:15479 / S2:0o510306).
C  Точки входа: DATAPR (главная), DATE*, PREPDAT.
 DATAPR:,NAME,     ; (DATAPR)        ; S5:7645  ; полное имя: DATE_PRINT
 DATA*:,LC,DBFLN        ; S5:7646  DATA*: LC 2 — 2-словный буфер даты
 DATAPR:,BSS,.     ; (DATAPR)        ; S5:7647  главная точка входа  . полное имя: DATE_PRINT
C  ПЕЧАТЬ ДАТЫ ПО ФОРМАТУ  DD MON 7Y HH.MM.
C-------------------------------------------        ; S5:7648
C ПEЧATЬ ДATЫ        ; S5:7649
C ПO ФOPMATY  DD MON 7Y HH.MM        ; S5:7650
C-------------------------------------------        ; S5:7651
C  Сохранение M13, настройка базы DARET.
 ,ITS,RETLR        ; S5:7652  сохранить M13
 13,BASE,DPARSE        ; S5:7653  M13 <- база DARET
C  DATE*: ENTRY — получение даты/времени через FUN 67B.
 DGET:,ENTRY,      ; (DATE*)        ; S5:7654  ; полное имя: DATE_GET
 DGET:,BSS,        ; (DATE*)        ; S5:7655  ; полное имя: DATE_GET
 ,ITS,.        ; S5:7656
 ,FUN,FUNDTM        ; S5:7657  FUN 67B — системная функция даты/времени
 ,NTR,MODE_6        ; S5:7658
 13,UJ,.        ; S5:7659  13,UJ,. — возврат через M13
C  DARET: разбор результата FUN 67B, выборка месяца из MARR.
 DPARSE:,BSS,     ; (DARET)        ; S5:7660  ; полное имя: DATE_PARSE
 ,XTS,DATE0        ; S5:7661
 15,XTS,STKOF2        ; S5:7662
 ,AUX,DYMSK        ; S5:7663  ; DYMSK = маска = TEXT/GOST слово DYMSK [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 ,ASN,DTDAYS.        ; S5:7664
 ,AOX,DATE1        ; S5:7665
 15,XTS,STKOF3        ; S5:7666
 ,AAX,MONTHFI        ; S5:7667
 ,ASN,DTMOSH        ; S5:7668
 15,ATX,        ; S5:7669
 ,YTA,        ; S5:7670
 14,VTM,MNTHIB        ; S5:7671
 ,UZA,DTWTCS        ; S5:7672
 14,VTM,        ; S5:7673
 DTWTCS:15,WTC,  ; (L1)        ; S5:7674  ; полное имя: DATE_WTC_SET
C  MARR — таблица названий месяцев (ЯНВ … ДЕК).
 ,XTA,MNTHNM        ; S5:7675  MARR — названия месяцев
 14,ASN,ISOWSH        ; S5:7676
 ,ASN,DTMISH        ; S5:7677
 15,XTS,STKOF4        ; S5:7678
 ,ASN,DTYRSH.        ; S5:7679
 ,AUX,YMASK        ; S5:7680  ; YMASK = маска = TEXT/GOST слово YMASK [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 15,AOX,        ; S5:7681
 ,AOX,DATE2        ; S5:7682
 15,XTS,STKOF4        ; S5:7683
 ,ASN,DTTMSH.        ; S5:7684
 ,AUX,TMASK        ; S5:7685  ; TMASK = маска = TEXT/GOST слово TMASK [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 ,AOX,DATE3        ; S5:7686
 ,XTS,DATE4        ; S5:7687
 15,XTS,SOM        ; S5:7688
 15,MTJ,RETLR        ; S5:7689
 ,UZA,DTENDC        ; S5:7690
 13,UTM,ONEW        ; S5:7691
 DTENDC:,UTC,DTSTAD  ; (L2/L3)        ; S5:7692  ; полное имя: DATE_END_CHECK
C  PRINT — вывод сформированной строки.
 ,PRINT,        ; S5:7693  PRINT — вывод строки
 15,UTM,STKOF6        ; S5:7694
 15,XTA,        ; S5:7695
 ,STI,RETLR        ; S5:7696
 13,UJ,        ; S5:7697
C  PREPDAT: ENTRY — подготовка даты и передача в DATAPR.
 DPREPA:,ENTRY,  ; (PREPDAT)        ; S5:7698  ; полное имя: DATE_PREPARE
 ,ITS,RETLR.        ; S5:7699
 13,VJM,DGET        ; S5:7700  VJM DATE*
 DPREPB:13,BAS,DPREPB  ; (B)        ; S5:7701  ; полное имя: DATE_PREP_BASE
 15,ATX,        ; S5:7702
 ,ASN,DTYRSH        ; S5:7703
 ,AUX,TL0018        ; S5:7704  ; TL0018 = маска = TEXT/GOST слово =6H'17''17''''''''' [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 ,AOX,TL0004        ; S5:7705
 ,STX,DATA*+1        ; S5:7706
 ,AUX,TL0021        ; S5:7707  ; TL0021 = маска = TEXT/GOST слово =6H'3''17''''17''17''' [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 ,AOX,TL0008        ; S5:7708
 ,STX,DATA*        ; S5:7709
 ,STI,RETLR        ; S5:7710
 ,UJ,DATAPR        ; S5:7711  UJ DATAPR
 DTSTAD:13,Z00,STKOF5        ; S5:7712  ; полное имя: DATE_STACK_ADJUST
 15,Z00,STKOF1        ; S5:7713
C  GOST/ISO-константы формата даты.
 DATE0:,GOST,TL0019        ; S5:7714
 DATE1:,GOST,TL0002        ; S5:7715
C ПOЗИЦИИ        ; S5:7716
 ,CONT,TL0001        ; S5:7717
 ,CONT,TL0003        ; S5:7718
 DATE2:,GOST,TL0007.        ; S5:7719
 DATE4:,BSS,        ; S5:7720
 MNTHNM:,GOST,    ; (MARR)TL0020        ; S5:7721  ; полное имя: MONTH_NAMES
 ,GOST,TL0022        ; S5:7722
 ,GOST,TL0012        ; S5:7723
 ,GOST,TL0024        ; S5:7724
 ,GOST,TL0010        ; S5:7725
 DATE3:,GOST,TL0017        ; S5:7726
 DYMSK:,BSS,.       ; (DMASK)        ; S5:7727  . полное имя: DAY_MASK
 TIMMSK:,GOST,      ; (TMASK)TL0009        ; S5:7728  ; полное имя: TIME_MASK
 YRMSK:,GOST,      ; (YMASK)TL0005.        ; S5:7729  ; полное имя: YEAR_MASK
 ,GOST,TL0016        ; S5:7730
 ,GOST,TL0023        ; S5:7731
 MNTHFD:,OCT,     ; (MONTHFI)00 776        ; S5:7732  ; полное имя: MONTH_FIELD
C  Конец DATAPR.
 ,END,DATAPR        ; S5:7733  END DATAPR

C----- 4a. OCTTDE (OCTTDE): число → 6 ISO-цифр (S6:5042-5084) -----
C  Экспортируется модулем DECODER (S3:1181).
C  Вызывается корнем RMON (S1:15498 / S2:0o510322), TCATALOG,
C  OVERLOAD, SUMOVER (S3:1182-84).
 OCTTDE :  ,NAME,     ; (OCTTDE)        ; S6:5042  ; полное имя: OCT_DEC
 OCTBAS :  ,BSS,     ; (C)        ; S6:5043  ; полное имя: OCT_BASE
C  BEGIN: база C; CYCL — выделение 6 цифр делением на 10^k.
 OCTBGN   :12,VTM,OCTBAS                        .        ; S6:5044  BEGIN: M12 <- C (база)  . полное имя: OCT_BEGIN
            ,XTS,                         .        ; S6:5045
          12,STX,DEC-OCTBAS                    .        ; S6:5046
          12,AAX,OCTSDM        ; S6:5047  AAX =7777777-C — маска 6 цифр
          12,AOX,INT0-OCTBAS                   .        ; S6:5048  AOX INT0-OCTBAS — константа INT0
          12,ATX,OCT-OCTBAS                    .        ; S6:5049
          14,VTM,STKOF5        ; S6:5050
C  CYCL: NTR 3 / A/X / NTR 2 / A*X — вещественная арифметика.
 OCTCYC    :  ,NTR,                         .        ; S6:5051  . полное имя: OCT_CYCLE
          12,XTA,OCT-OCTBAS                    .        ; S6:5052
          14,UTC,C1                       .        ; S6:5053
            ,A/X,                         .        ; S6:5054
            ,NTR,LIT_3.        ; S6:5055
          12,A+X,INT0-OCTBAS                   .        ; S6:5056
          15,ATX,                         .        ; S6:5057
            ,NTR,LIT_2.        ; S6:5058
          14,UTC,C1                       .        ; S6:5059
            ,A*X,                         .        ; S6:5060
          12,X-A,OCT-OCTBAS                    .        ; S6:5061
          12,STX,OCT-OCTBAS                    .        ; S6:5062
          12,AAX,MASK15-OCTBAS                 .        ; S6:5063
          12,AOX,DEC-OCTBAS                    .        ; S6:5064
          14,VLM,OCTSYM        ; S6:5065
C  AOX ZERO — склейка ISO-кодов цифр; NTR 10; возврат через M13.
          12,AOX,ZERO-OCTBAS                   .        ; S6:5066  AOX ZERO-OCTBAS — добавить коды «0»
            ,NTR,LIT_10.        ; S6:5067
          13, UJ,                         .        ; S6:5068  13,UJ — возврат через M13
 OCTSYM  :  ,BSS,        ; S6:5069  ; полное имя: OCT_SYMBOL
            ,ASN,OCTISS                     .        ; S6:5070
          12,ATX,DEC-OCTBAS                    .        ; S6:5071
            , UJ,OCTCYC        ; S6:5072
C  Константы: MASK15=77777, INT0=0, REAL 100000.0 … 1.0,
C  ZERO = «000000».
 OCT     :  ,OCT  ,                       .        ; S6:5073
 MASK15  :  ,OCT  ,DW0000.        ; S6:5074  MASK15 = 0000000000077777
 INT0    :  ,INT  ,INTZ        ; S6:5075  INT0 = 0
 DEC     :  ,OCT  ,                       .        ; S6:5076
         :  ,REAL,P5        ; S6:5077
         :  ,REAL ,P4                .        ; S6:5078
         :  ,REAL ,P3                 .        ; S6:5079
         :  ,REAL ,P2                  .        ; S6:5080
         :  ,REAL ,P1                   .        ; S6:5081
 C1      :  ,REAL ,1.0                    .        ; S6:5082  C1 = REAL 1.0
 ZERO    :  ,8TEXT,TL0000.        ; S6:5083  ZERO = 8TEXT «000000»
C  Конец OCTTDE (system2).
    ,END,        ; S6:5084  END

C----- 4b. OCTEXF (OCTTDE): вариант EXFOR (S7:427-459) -----
C  Тот же интерфейс, альтернативная реализация: умножение на 0.1
C  (C1/10) и C10; возврат через M15; ZERO = ISO 6H000000.
 OCTEXF:,NAME,  ; (OCTTDE)        ; S7:427  ; полное имя: OCT_DEC_EXFOR
 14,BASE,*        ; S7:428  14,BASE,* — база M14
 ,AAX,B40/1        ; S7:429
 ,ITS,RETLR        ; S7:430  ITS,13 — сохранить M13
 13,VTM,        ; S7:431
 ,NTR,RMOD3        ; S7:432  NTR 3 — вещественный режим
 ,XTS,        ; S7:433
 OCTEDL:15,XTS,  ; (L1)STKOF3        ; S7:434  ; полное имя: OCT_EX_DIGIT_LOOP
 ,A*X,C1/10        ; S7:435  A*X,C1/10 — умножить на 0.1
 15,ATX,STKOF3        ; S7:436
 ,YTA,ISOWSH        ; S7:437
 ,A*X,C10        ; S7:438
 13,ASN,ISOWSH        ; S7:439
 13,UTM,STKOF4        ; S7:440
 15,AOX,        ; S7:441
 15,XTS,STKOF3        ; S7:442
 ,UZA,OCTERT        ; S7:443  UZA RET — конец цифр
 ,STX,        ; S7:444
 ,UJ,OCTEDL        ; S7:445
 OCTERT:,STX,   ; (RET)        ; S7:446  RET: STX  ; полное имя: OCT_EX_RETURN
 15,UTM,STKOF2        ; S7:447  15,UTM,-2 — сдвиг стека
 ,ASN,DTMISH        ; S7:448
 ,AUX,MSK        ; S7:449  ; MSK = маска = TEXT/GOST слово MSK [monitor80-re/permanent/star%.masm:490; monitor80-re/permanent/paramt%.masm:365; monitor80-re/permanent/edit%%%.asm:996], НЕ адрес данных
 ,AOX,ZERO        ; S7:450
 ,NTR,FIXM2        ; S7:451
 15,WTC,ONEW        ; S7:452  15,WTC,1
 ,UJ,        ; S7:453  UJ — возврат через M15
 B40/1:,LOG,DW0006        ; S7:454
 C10:,LOG,4000 0000 0000 0012        ; S7:455
 C1/10:,LOG,4001 4631 4631 4632        ; S7:456  C1/10 = LOG 4001 4631 4631 4632 (0.1)
 MSK:,GOST,GOSTBL        ; S7:457
 ZERO:,ISO,TL0006        ; S7:458  ZERO = ISO 6H000000
C  Конец OCTTDE (exfor).
 ,END,        ; S7:459  END

