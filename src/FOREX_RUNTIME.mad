C  Диагностика «ERROR IN STANDARD ARRAY».
 *00101    :, ISO    ,TEXT_LIT_6HERROR        ; S1:15707
            , ISO    ,TEXT_LIT_6HIN_STA        ; S1:15708
            , ISO    ,TEXT_LIT_6HNDART        ; S1:15709
