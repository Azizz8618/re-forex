      ,END,        ; S1:15712  END FORTLIBR

C----- 3. DATE_PRINT (DATAPR*): печать даты DD MON YY HH.MM (S5:7645-7733) -----
C  Резидент MONSYS; вызывается корнем INITFOR* (S1:15479 / S2:0o510306).
C  Точки входа: DATAPR* (главная), DATE*, PREPDAT.
 DATE_PRINT:,NAME,     ; (DATAPR*)        ; S5:7645
 DATA*:,LC,DATE_BUF_LEN        ; S5:7646  DATA*: LC 2 — 2-словный буфер даты
 DATE_PRINT:,BSS,.     ; (DATAPR*)        ; S5:7647  главная точка входа
C  ПЕЧАТЬ ДАТЫ ПО ФОРМАТУ  DD MON 7Y HH.MM.
C-------------------------------------------        ; S5:7648
C ПEЧATЬ ДATЫ        ; S5:7649
C ПO ФOPMATY  DD MON 7Y HH.MM        ; S5:7650
C-------------------------------------------        ; S5:7651
C  Сохранение M13, настройка базы DARET.
 ,ITS,RET_LINK_REG        ; S5:7652  сохранить M13
 13,BASE,DATE_PARSE        ; S5:7653  M13 <- база DARET
C  DATE*: ENTRY — получение даты/времени через FUN 67B.
 DATE_GET:,ENTRY,      ; (DATE*)        ; S5:7654
 DATE_GET:,BSS,        ; (DATE*)        ; S5:7655
 ,ITS,.        ; S5:7656
 ,FUN,FUN_DATE_TIME        ; S5:7657  FUN 67B — системная функция даты/времени
 ,NTR,MODE_6        ; S5:7658
 13,UJ,.        ; S5:7659  13,UJ,. — возврат через M13
C  DARET: разбор результата FUN 67B, выборка месяца из MARR.
 DATE_PARSE:,BSS,     ; (DARET)        ; S5:7660
 ,XTS,DATE0        ; S5:7661
 15,XTS,STACK_OFF_M2        ; S5:7662
 ,AUX,DAY_MASK        ; S5:7663
 ,ASN,DATE_DAY_SHIFT.        ; S5:7664
 ,AOX,DATE1        ; S5:7665
 15,XTS,STACK_OFF_M3        ; S5:7666
 ,AAX,MONTHFI        ; S5:7667
 ,ASN,DATE_MONTH_SHIFT        ; S5:7668
 15,ATX,        ; S5:7669
 ,YTA,        ; S5:7670
 14,VTM,MONTH_INDEX_BASE        ; S5:7671
 ,UZA,DATE_WTC_SET        ; S5:7672
 14,VTM,        ; S5:7673
 DATE_WTC_SET:15,WTC,  ; (L1)        ; S5:7674
C  MARR — таблица названий месяцев (ЯНВ … ДЕК).
 ,XTA,MONTH_NAMES        ; S5:7675  MARR — названия месяцев
 14,ASN,ISO_WORD_SHIFT        ; S5:7676
 ,ASN,DATE_MONTH_INDEX_SHIFT        ; S5:7677
 15,XTS,STACK_OFF_M4        ; S5:7678
 ,ASN,DATE_YEAR_SHIFT.        ; S5:7679
 ,AUX,YMASK        ; S5:7680
 15,AOX,        ; S5:7681
 ,AOX,DATE2        ; S5:7682
 15,XTS,STACK_OFF_M4        ; S5:7683
 ,ASN,DATE_TIME_SHIFT.        ; S5:7684
 ,AUX,TMASK        ; S5:7685
 ,AOX,DATE3        ; S5:7686
 ,XTS,DATE4        ; S5:7687
 15,XTS,STACK_OFF_M8        ; S5:7688
 15,MTJ,RET_LINK_REG        ; S5:7689
 ,UZA,DATE_END_CHECK        ; S5:7690
 13,UTM,ONE_WORD        ; S5:7691
 DATE_END_CHECK:,UTC,DATE_STACK_ADJUST  ; (L2/L3)        ; S5:7692
C  PRINT — вывод сформированной строки.
 ,PRINT,        ; S5:7693  PRINT — вывод строки
 15,UTM,STACK_OFF_M6        ; S5:7694
 15,XTA,        ; S5:7695
 ,STI,RET_LINK_REG        ; S5:7696
 13,UJ,        ; S5:7697
C  PREPDAT: ENTRY — подготовка даты и передача в DATAPR*.
 DATE_PREPARE:,ENTRY,  ; (PREPDAT)        ; S5:7698
 ,ITS,RET_LINK_REG.        ; S5:7699
 13,VJM,DATE_GET        ; S5:7700  VJM DATE*
 DATE_PREP_BASE:13,BAS,DATE_PREP_BASE  ; (B)        ; S5:7701
 15,ATX,        ; S5:7702
 ,ASN,DATE_YEAR_SHIFT        ; S5:7703
 ,AUX,TEXT_LIT_6H_17_17        ; S5:7704
 ,AOX,TEXT_LIT_6H00        ; S5:7705
 ,STX,DATA*+1        ; S5:7706
 ,AUX,TEXT_LIT_6H_3_17_17_17        ; S5:7707
 ,AOX,TEXT_LIT_6H00_00        ; S5:7708
 ,STX,DATA*        ; S5:7709
 ,STI,RET_LINK_REG        ; S5:7710
 ,UJ,DATE_PRINT        ; S5:7711  UJ DATAPR*
 DATE_STACK_ADJUST:13,Z00,STACK_OFF_M5        ; S5:7712
 15,Z00,STACK_OFF_M1        ; S5:7713
C  GOST/ISO-константы формата даты.
 DATE0:,GOST,TEXT_LIT_6H_201_200_7        ; S5:7714
 DATE1:,GOST,TEXT_LIT_2H_200        ; S5:7715
C ПOЗИЦИИ        ; S5:7716
 ,CONT,TEXT_LIT_1H_055        ; S5:7717
 ,CONT,TEXT_LIT_3H00        ; S5:7718
 DATE2:,GOST,TEXT_LIT_6H000_00.        ; S5:7719
 DATE4:,BSS,        ; S5:7720
 MONTH_NAMES:,GOST,    ; (MARR)TEXT_LIT_6H_231_HB        ; S5:7721
 ,GOST,TEXT_LIT_6H_EBMAP        ; S5:7722
 ,GOST,TEXT_LIT_6HA_PMA        ; S5:7723
 ,GOST,TEXT_LIT_6H_H        ; S5:7724
 ,GOST,TEXT_LIT_6HAB_CEH        ; S5:7725
 DATE3:,GOST,TEXT_LIT_6H_00_00        ; S5:7726
 DAY_MASK:,BSS,.       ; (DMASK)        ; S5:7727
 TIME_MASK:,GOST,      ; (TMASK)TEXT_LIT_6H03_0        ; S5:7728
 YEAR_MASK:,GOST,      ; (YMASK)TEXT_LIT_6H0000.        ; S5:7729
 ,GOST,TEXT_LIT_6HOKTHO        ; S5:7730
 ,GOST,TEXT_LIT_6H_EK        ; S5:7731
 MONTH_FIELD:,OCT,     ; (MONTHFI)00 776        ; S5:7732
C  Конец DATAPR*.
 ,END,DATE_PRINT        ; S5:7733  END DATAPR*

C----- 4a. OCT_DEC (OCTTDEC): число → 6 ISO-цифр (S6:5042-5084) -----
C  Экспортируется модулем DECODER (S3:1181).
C  Вызывается корнем RMON (S1:15498 / S2:0o510322), TCATALOG,
C  OVERLOAD, SUMOVER (S3:1182-84).
 OCT_DEC :  ,NAME,     ; (OCTTDEC)        ; S6:5042
 OCT_BASE :  ,BSS,     ; (C)        ; S6:5043
C  BEGIN: база C; CYCL — выделение 6 цифр делением на 10^k.
 OCT_BEGIN   :12,VTM,OCT_BASE                        .        ; S6:5044  BEGIN: M12 <- C (база)
            ,XTS,                         .        ; S6:5045
          12,STX,DEC-OCT_BASE                    .        ; S6:5046
          12,AAX,OCT_SIX_DIGIT_MASK        ; S6:5047  AAX =7777777-C — маска 6 цифр
          12,AOX,INT0-OCT_BASE                   .        ; S6:5048  AOX INT0-OCT_BASE — константа INT0
          12,ATX,OCT-OCT_BASE                    .        ; S6:5049
          14,VTM,STACK_OFF_M5        ; S6:5050
C  CYCL: NTR 3 / A/X / NTR 2 / A*X — вещественная арифметика.
 OCT_CYCLE    :  ,NTR,                         .        ; S6:5051
          12,XTA,OCT-OCT_BASE                    .        ; S6:5052
          14,UTC,C1                       .        ; S6:5053
            ,A/X,                         .        ; S6:5054
            ,NTR,LIT_3.        ; S6:5055
          12,A+X,INT0-OCT_BASE                   .        ; S6:5056
          15,ATX,                         .        ; S6:5057
            ,NTR,LIT_2.        ; S6:5058
          14,UTC,C1                       .        ; S6:5059
            ,A*X,                         .        ; S6:5060
          12,X-A,OCT-OCT_BASE                    .        ; S6:5061
          12,STX,OCT-OCT_BASE                    .        ; S6:5062
          12,AAX,MASK15-OCT_BASE                 .        ; S6:5063
          12,AOX,DEC-OCT_BASE                    .        ; S6:5064
          14,VLM,OCT_SYMBOL        ; S6:5065
C  AOX ZERO — склейка ISO-кодов цифр; NTR 10; возврат через M13.
          12,AOX,ZERO-OCT_BASE                   .        ; S6:5066  AOX ZERO-OCT_BASE — добавить коды «0»
            ,NTR,LIT_10.        ; S6:5067
          13, UJ,                         .        ; S6:5068  13,UJ — возврат через M13
 OCT_SYMBOL  :  ,BSS,        ; S6:5069
            ,ASN,OCT_ISO_SHIFT                     .        ; S6:5070
          12,ATX,DEC-OCT_BASE                    .        ; S6:5071
            , UJ,OCT_CYCLE        ; S6:5072
C  Константы: MASK15=77777, INT0=0, REAL 100000.0 … 1.0,
C  ZERO = «000000».
 OCT     :  ,OCT  ,                       .        ; S6:5073
 MASK15  :  ,OCT  ,DATA_WORD_0000000000077777.        ; S6:5074  MASK15 = 0000000000077777
 INT0    :  ,INT  ,INT_ZERO        ; S6:5075  INT0 = 0
 DEC     :  ,OCT  ,                       .        ; S6:5076
         :  ,REAL,POW10_5        ; S6:5077
         :  ,REAL ,POW10_4                .        ; S6:5078
         :  ,REAL ,POW10_3                 .        ; S6:5079
         :  ,REAL ,POW10_2                  .        ; S6:5080
         :  ,REAL ,POW10_1                   .        ; S6:5081
 C1      :  ,REAL ,1.0                    .        ; S6:5082  C1 = REAL 1.0
 ZERO    :  ,8TEXT,TEXT_LIT_000000.        ; S6:5083  ZERO = 8TEXT «000000»
C  Конец OCTTDEC (system2).
    ,END,        ; S6:5084  END

C----- 4b. OCT_DEC_EXFOR (OCTTDEC): вариант EXFOR (S7:427-459) -----
C  Тот же интерфейс, альтернативная реализация: умножение на 0.1
C  (C1/10) и C10; возврат через M15; ZERO = ISO 6H000000.
 OCT_DEC_EXFOR:,NAME,  ; (OCTTDEC)        ; S7:427
 14,BASE,*        ; S7:428  14,BASE,* — база M14
 ,AAX,B40/1        ; S7:429
 ,ITS,RET_LINK_REG        ; S7:430  ITS,13 — сохранить M13
 13,VTM,        ; S7:431
 ,NTR,REAL_MODE_3        ; S7:432  NTR 3 — вещественный режим
 ,XTS,        ; S7:433
 OCT_EX_DIGIT_LOOP:15,XTS,  ; (L1)STACK_OFF_M3        ; S7:434
 ,A*X,C1/10        ; S7:435  A*X,C1/10 — умножить на 0.1
 15,ATX,STACK_OFF_M3        ; S7:436
 ,YTA,ISO_WORD_SHIFT        ; S7:437
 ,A*X,C10        ; S7:438
 13,ASN,ISO_WORD_SHIFT        ; S7:439
 13,UTM,STACK_OFF_M4        ; S7:440
 15,AOX,        ; S7:441
 15,XTS,STACK_OFF_M3        ; S7:442
 ,UZA,OCT_EX_RETURN        ; S7:443  UZA RET — конец цифр
 ,STX,        ; S7:444
 ,UJ,OCT_EX_DIGIT_LOOP        ; S7:445
 OCT_EX_RETURN:,STX,   ; (RET)        ; S7:446  RET: STX
 15,UTM,STACK_OFF_M2        ; S7:447  15,UTM,-2 — сдвиг стека
 ,ASN,DATE_MONTH_INDEX_SHIFT        ; S7:448
 ,AUX,MSK        ; S7:449
 ,AOX,ZERO        ; S7:450
 ,NTR,FIXED_MODE_2        ; S7:451
 15,WTC,ONE_WORD        ; S7:452  15,WTC,1
 ,UJ,        ; S7:453  UJ — возврат через M15
 B40/1:,LOG,DATA_WORD_17_7777_7777_7777        ; S7:454
 C10:,LOG,4000 0000 0000 0012        ; S7:455
 C1/10:,LOG,4001 4631 4631 4632        ; S7:456  C1/10 = LOG 4001 4631 4631 4632 (0.1)
 MSK:,GOST,GOST_BLANK        ; S7:457
 ZERO:,ISO,TEXT_LIT_6H000000        ; S7:458  ZERO = ISO 6H000000
C  Конец OCTTDEC (exfor).
 ,END,        ; S7:459  END

C***********************************************************************
C*  GIV/PG + TAK/PG — НЕ ДУБЛИРУЮТСЯ                                    *
C*  Полный аннотированный текст уже в include/FOREX_ROOT.mad:198-254  *
C*  (источник S1:16780-16836). Он обеспечивает обмен страницами/       *
C*  памятью для FOREX*; ссылка отсюда — только на тот файл.            *
C***********************************************************************

C***********************************************************************
C*  КАРТА ВЫЗОВОВ (S1 / S3 / S5-S7)                                      *
C*                                                                       *
C*  INITFOR* (FOREX*) --CALL--> DATAPR*     S1:15479 / S2:0o510306      *
C*  INIT_FOREX (INITFOR*) --CALL--> PAGE_GIVE (GIV/PG)     S1:15484 → FOREX_ROOT.mad   *
C*  LOAD_OVERLAYS (LOREX) --CALL--> LOADANGO   S1:15487,15489              *
C*  PRINT_TIME (RMON) --CALL--> OCT_DEC (OCTTDEC)    S1:15498 / S2:0o510322      *
C*  ERR_TRANSLATOR (STOP/) --UJ----> PAGE_TAKE (TAK/PG)    S1:15510 → FOREX_ROOT.mad   *
C*  DATE_PRINT -> DATE_GET (FUN 67B); DATE_PREPARE -> DATE_GET -> DATE_PRINT  S5:7700,7711*
C*  FT_FORMAT_DISPATCH (FORMAT) --UJ x11--> FT*571 … FT*003    S1:15565-15586              *
C*     FT*571 импортируется из ANL (S3:1075); FT*521/531/541/561/      *
C*     611/621/641/721, FT*002, FT*003 экспортирует FORMAT (S3:206-216) *
C*  FT_LIBRARY_IO (FORTLIBR) PRINT8 --VJM--> WRITLIBR+1, PRINT8   S1:15603,15615        *
C*  DECODER  --экспорт--> OCT_DEC (OCTTDEC)               S3:1181                 *
C*  (вариант WRITLIBR из libra212.l21:3208+ вызывает PT6/G, STATSUM,    *
C*   SAVELIST — отдельная улика, не отождествлять с FORTLIBR без проверки)*
C***********************************************************************

C***********************************************************************
C*  ТАБЛИЦА РЕГИСТРОВ                                                    *
C*  M7  — рабочий регистр PRINT8: VTM *00061, XTS/ATX *00064/*00100     *
C*  M12 — FORMAT: база таблицы 77766B, счётчик цикла VLM (S1:15549,55)  *
C*  M13 — FT_FORMAT_DISPATCH/DATE_PRINT/OCT_DEC: база DARET (S5:7653), возврат         *
C*        (S5:7659, S6:5068), linkage PRINT8 (S1:15603,15615)           *
C*  M14 — FORMAT: индекс таблицы (S1:15541,48,53,54); PRINT8: база      *
C*        констант *00061 (S1:15594); DATAPR*: индекс месяца (S5:7671)  *
C*  M15 — OCTTDEC(exfor): указатель стека/возврат (S7:447,452,453)      *
C*  Модификатор (WTC) используется в FORMAT (S1:15552) и PRINT8        *
C*  (S1:15635,15645,15653) для адресации полей буфера.                  *
C***********************************************************************

C***********************************************************************
C*  ИСТОЧНИКИ / СИНХРОНИЗАЦИЯ                                            *
C*  S1 libra211.l21:15529-15712 → reference/libra211.format.inc        *
C*  S5 besmmons/system1.txt:7645-7733   (DATAPR*)                       *
C*  S6 besmmons/system2.txt:5042-5084   (OCTTDEC, DECODER)              *
C*  S7 besmtask/exfor.vv:427-459        (OCTTDEC, EXFOR-вариант)         *
C*  S2 monsys.9 (besm6tape.py dis / extract_words.py --decode-text)     *
C*  S3 expect_library21.txt:206-218,1055-1088,1181-1184,1313            *
C*  S4 expect_forex.txt:44,49 (OCTTDEC 04773, PRINT8 03324)             *
C*  См. include/FOREX_RUNTIME.xref.md, .registers.md, docs/07-runtime.md*
C***********************************************************************
