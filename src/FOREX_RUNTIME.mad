C***********************************************************************
C* FOREX_RUNTIME — библиотечные/рантайм-модули компилятора ФОРЭКС       *
C* Аннотированный МАДЛЕН-текст (субагент «рантайм»)                     *
C*                                                                       *
C* СОСТАВ:                                                                *
C*   1 FORMAT    — диспетчер таблицы входов FT*        S1:15529-15589    *
C*   2 FORTLIBR  — PRINT8 / WRITLIBR                   S1:15590-15712    *
C*   3 DATAPR*   — печать даты DD MON YY HH.MM        S5:7645-7733      *
C*   4 OCTTDEC   — число → 6 ISO-цифр                 S6:5042-5084      *
C*                                                   S7:427-459        *
C*   GIV/PG + TAK/PG УЖЕ ЕСТЬ в include/FOREX_ROOT.mad — НЕ ДУБЛИРУЕМ    *
C*                                                                       *
C* ПРОИСХОЖДЕНИЕ:                                                         *
C*  S1 /home/azizz/besm6.github.io/sources/dubna/besml21/libra211.l21     *
C*  S5 /home/azizz/besm6.github.io/sources/dubna/besmmons/system1.txt     *
C*  S6 /home/azizz/besm6.github.io/sources/dubna/besmmons/system2.txt     *
C*  S7 /home/azizz/besm6.github.io/sources/dubna/besmtask/exfor.vv        *
C*  S2 monsys.9: 0o510413-0o510431 таблица входов корня (0o510421        *
C*     DATAPR*, 0o510424 OCTTDEC); 0o512527 каталог DATAPR*;             *
C*     0o510443-0o510522 скомпилированный диспетчер FORMAT              *
C*  S3 reference/expect_library21.txt (LIBREFER) — экспорт/импорт        *
C*  S4 reference/expect_forex.txt — адреса 4.13: OCTTDEC 04773,         *
C*     PRINT8 03324                                                    *
C***********************************************************************

C----- 1. FORMAT: диспетчер таблицы входов FT* (S1:15529-15589) -----
C  Модуль не форматирует данные сам: он строит таблицу передач,
C  записывая адреса 11 подпрограмм FT* в ячейки 77xxxB (S3:206-216).
      FORMAT     :,NAME,        ; S1:15529
C  Объявлены 11 внешних подпрограмм: FT*571 … FT*003.
      FT*571     :,SUBP,        ; S1:15530
      FT*541     :,SUBP,        ; S1:15531
      FT*611     :,SUBP,        ; S1:15532
      FT*531     :,SUBP,        ; S1:15533
      FT*561     :,SUBP,        ; S1:15534
      FT*621     :,SUBP,        ; S1:15535
      FT*521     :,SUBP,        ; S1:15536
      FT*721     :,SUBP,        ; S1:15537
      FT*641     :,SUBP,        ; S1:15538
      FT*002     :,SUBP,        ; S1:15539
      FT*003     :,SUBP,        ; S1:15540
C  Настройка M14 и вычисление смещения в таблице передач.
                 ,ATI,  14        ; S1:15541  M14 <- acc: установка индексного регистра
            14 ,  XTA,        ; S1:15542  acc <- (M14)
                 ,ASN,  103B        ; S1:15543  ASN 103B: выделение поля адреса
                 ,YTA,        ; S1:15544
                 ,UTC,   *00027        ; S1:15545  UTC *00027: прибавить константу
                 ,AEX,        ; S1:15546
                 ,UIA,   *00010        ; S1:15547
            14 ,  XTA,        ; S1:15548
C  M12 = база 77766B; цикл VLM по M12 обходит таблицу.
 *00004    :12 ,  VTM,  77766B        ; S1:15549  M12 <- база 77766B
                 ,UTC,        ; S1:15550
 *00005    :     ,ATI,  14        ; S1:15551
            12 ,  WTC,   *00026        ; S1:15552  WTC *00026: модификатор адреса
            14 ,  UTM,        ; S1:15553
            14 ,  VZM,   *00012        ; S1:15554  VZM *00012: переход при нулевом M14
            12 ,  VLM,   *00005        ; S1:15555  VLM *00005: цикл по M12
                 , IJ,        ; S1:15556
C  Вычисление адреса очередной пары «UJ FT* / ATX 77xxxB».
 *00010    :     ,UTC,   *00027        ; S1:15557  формирование смещения (ASN 155B)
                 ,AEX,        ; S1:15558
                 ,ASN,  155B        ; S1:15559
                 , UJ,   *00004        ; S1:15560
C  STX + ATI 14: запись и продвижение указателя таблицы.
 *00012    :     ,STX,        ; S1:15561
                 ,ATI,  14        ; S1:15562
            12 ,   UJ,   *00026        ; S1:15563
                 ,UTC,        ; S1:15564
C  ТАБЛИЦА ПЕРЕХОДОВ: 11 пар UJ FT*nnn / ATX 77xxxB.
C  FT*571 реально экспортирует ANL (S3:1075), остальные 10 — FORMAT.
                 , UJ,  FT*571        ; S1:15565  FT*571 -> 77207B (импорт из ANL)
                 ,ATX,  77207B        ; S1:15566
                 , UJ,  FT*541        ; S1:15567  FT*541 -> 77237B
                 ,ATX,  77237B        ; S1:15568
                 , UJ,  FT*611        ; S1:15569  FT*611 -> 77167B
                 ,ATX,  77167B        ; S1:15570
                 , UJ,  FT*531        ; S1:15571  FT*531 -> 77247B
                 ,ATX,  77247B        ; S1:15572
                 , UJ,  FT*561        ; S1:15573  FT*561 -> 77217B
                 ,ATX,  77217B        ; S1:15574
                 , UJ,  FT*621        ; S1:15575  FT*621 -> 77157B
                 ,ATX,  77157B        ; S1:15576
                 , UJ,  FT*521        ; S1:15577  FT*521 -> 77257B
                 ,ATX,  77257B        ; S1:15578
                 , UJ,  FT*721        ; S1:15579  FT*721 -> 77057B
                 ,ATX,  77057B        ; S1:15580
                 , UJ,  FT*641        ; S1:15581  FT*641 -> 77137B
                 ,ATX,  77137B        ; S1:15582
                 , UJ,  FT*002        ; S1:15583  FT*002 -> 77776B
                 ,ATX,  77776B        ; S1:15584
 *00026    :     , UJ,  FT*003        ; S1:15585  FT*003 -> 77775B
                 ,ATX,  77775B        ; S1:15586
C  Константы и конец модуля.
 *00027    :,     LOG,  10000000 00000000.        ; S1:15587  *00027: LOG 10000000 00000000
 BSS       :     ,BSS,        ; S1:15588
      ,END,        ; S1:15589  END FORMAT

C----- 2. FORTLIBR: PRINT8 / WRITLIBR (S1:15590-15712) -----
C  Экспорт: PRINT8 (S3:217), WRITLIBR (S3:1313).
C  BUFFER PU 2000B — буфер обмена с библиотекой.
      FORTLIBR   :,NAME,        ; S1:15590
      BUFFER     :,PU,  2000B        ; S1:15591  BUFFER: PU 2000B (0o2000 слов)
      WRITLIBR   :,SUBP,        ; S1:15592  SUBP — точка входа (экспорт)
      PRINT8     :,SUBP,        ; S1:15593  SUBP — точка входа (экспорт)
C  PRINT8: печать 8-символьного ISO-слова; M14/M7/M13 — рабочие.
            14 ,  VTM,   *00061        ; S1:15594  M14 <- *00061 (база констант)
L           14 ,  ATX,   *00077    - *00061        ; S1:15595
                 ,ITA,  7        ; S1:15596
                 ,ITS,  13        ; S1:15597
             7 ,  VTM,   *00061        ; S1:15598
L            7 ,  XTS,   *00064    - *00061        ; S1:15599
L            7 ,  ATX,   *00100    - *00061        ; S1:15600
            14 ,  VTM,   *00014        ; S1:15601
                 ,ITA,  14        ; S1:15602
C  VJM WRITLIBR+1 — вызов подготовительной части WRITLIBR.
L           13 ,  VJM,   WRITLIBR  +1        ; S1:15603  VJM WRITLIBR+1
                 ,UIA,   *00010        ; S1:15604
                 ,STI,        ; S1:15605
                 ,STI,  13        ; S1:15606
                 ,STI,  7        ; S1:15607
            13 ,   UJ,        ; S1:15608
                 ,UTC,        ; S1:15609
 *00010    :14 ,  VTM,   *00101        ; S1:15610
                 ,ITS,  14        ; S1:15611
            14 ,  UTM,  3        ; S1:15612
                 ,ITS,  14        ; S1:15613
                 ,ITS,        ; S1:15614
C  VJM PRINT8 — печать подготовленного слова.
            13 ,  VJM,  PRINT8        ; S1:15615  VJM PRINT8
                 , *74,        ; S1:15616
C  WRITLIBR: проверки и сборка выходного слова в BUFFER.
 *00014    :     ,ITS,  7        ; S1:15617
             7 ,  VTM,   *00061        ; S1:15618
             7 ,  ATX,        ; S1:15619
C  M14 = BUFFER: адрес буфера.
            14 ,  VTM,  BUFFER        ; S1:15620  M14 <- BUFFER
                 ,ITA,  14        ; S1:15621
L            7 ,  ATX,   *00071    - *00061        ; S1:15622
                 ,UTC,   *00100        ; S1:15623
                 ,XTA,        ; S1:15624
                 ,UZA,   *00023        ; S1:15625
L            7 ,  ATX,   *00062    - *00061        ; S1:15626
                 ,XTA,        ; S1:15627
L            7 ,  ATX,   *00063    - *00061        ; S1:15628
                 ,UTC,   *00100        ; S1:15629
                 ,ATX,        ; S1:15630
L*00023    : 7 ,  XTA,   *00062    - *00061        ; S1:15631
                 ,UZA,   *00045        ; S1:15632
L            7 ,  XTA,   *00063    - *00061        ; S1:15633
                 ,UIA,   *00032        ; S1:15634
C  WTC *00077 — установка модификатора адреса.
                 ,WTC,   *00077        ; S1:15635  WTC *00077
                 ,XTA,        ; S1:15636
                 ,AEX,        ; S1:15637
                 ,UZA,   *00036        ; S1:15638
L*00027    : 7 ,  XTS,   *00063    - *00061        ; S1:15639
L            7 ,  AEX,   *00064    - *00061        ; S1:15640
L            7 ,  STX,   *00063    - *00061        ; S1:15641
             7 ,  XTS,        ; S1:15642
                 ,STI,  7        ; S1:15643
            13 ,   UJ,        ; S1:15644
 *00032    :     ,WTC,   *00077        ; S1:15645
                 ,XTA,  1        ; S1:15646
L            7 ,  XTS,   *00077    - *00061        ; S1:15647
L            7 ,  ARX,   *00075    - *00061        ; S1:15648
L            7 ,  ATX,   *00077    - *00061        ; S1:15649
                 ,STX,        ; S1:15650
                 , UJ,   *00027        ; S1:15651
                 ,UTC,        ; S1:15652
 *00036    :     ,WTC,   *00077        ; S1:15653
                 ,XTA,  1        ; S1:15654
L            7 ,  ATX,   *00065    - *00061        ; S1:15655
                 ,XTA,        ; S1:15656
L            7 ,  ATX,   *00062    - *00061        ; S1:15657
L            7 ,  ATX,   *00072    - *00061        ; S1:15658
L            7 ,  ATX,   *00074    - *00061        ; S1:15659
                 , UJ,   *00045        ; S1:15660
L*00042    : 7 ,  ARX,   *00071    - *00061        ; S1:15661
L            7 ,  ATX,   *00072    - *00061        ; S1:15662
L            7 ,  XTA,   *00074    - *00061        ; S1:15663
L            7 ,  ARX,   *00064    - *00061        ; S1:15664
L            7 ,  ATX,   *00074    - *00061        ; S1:15665
                 ,UTC,        ; S1:15666
L*00045    : 7 ,  XTA,   *00072    - *00061        ; S1:15667
L            7 ,  AEX,   *00071    - *00061        ; S1:15668
                 ,UZA,   *00050        ; S1:15669
L            7 ,  AAX,   *00066    - *00061        ; S1:15670
                 ,UZA,   *00053        ; S1:15671
                 ,UTC,        ; S1:15672
L*00050    : 7 ,  XTA,   *00072    - *00061        ; S1:15673
L            7 ,  ARX,   *00064    - *00061        ; S1:15674
L            7 ,  ATX,   *00072    - *00061        ; S1:15675
                 ,WTC,   *00072        ; S1:15676
                 ,XTA,  77777B        ; S1:15677  XTA 77777B — маска
                 , UJ,   *00027        ; S1:15678
L*00053    : 7 ,  XTA,   *00065    - *00061        ; S1:15679
L            7 ,  ARX,   *00074    - *00061        ; S1:15680
L            7 ,  AAX,   *00073    - *00061        ; S1:15681
L            7 ,  AOX,   *00067    - *00061        ; S1:15682
L            7 ,  ATX,   *00070    - *00061        ; S1:15683
C  Экстракод *70 и сдвиг ASN 54B — сборка 8-символьного слова.
L            7 ,  XTS,   *00071    - *00061        ; S1:15684  ASN 54B
                 ,ASN,  54B        ; S1:15685
            15 ,  AOX,        ; S1:15686
L            7 ,  ATX,   *00070    - *00061        ; S1:15687
L            7 ,   *70,  *00070    - *00061        ; S1:15688  *70 — экстракод
                 ,XTA,        ; S1:15689
                 , UJ,   *00042        ; S1:15690
 *00061    :,     LOG,  00000000 00000000.        ; S1:15691
 *00062    :,     LOG,  00000000 00000000.        ; S1:15692
 *00063    :,     LOG,  00000000 00000000.        ; S1:15693
 *00064    :,     LOG,  00000000 00000001.        ; S1:15694
 *00065    :,     LOG,  00000000 00000000.        ; S1:15695
 *00066    :,     LOG,  00000000 00001777.        ; S1:15696
 *00067    :,     LOG,  00100000 00000000.        ; S1:15697
 *00070    :,     LOG,  00000000 00000000.        ; S1:15698
 *00071    :,     LOG,  00000000 00000000.        ; S1:15699
 *00072    :,     LOG,  00000000 00000000.        ; S1:15700
 *00073    :,     LOG,  37777774 77777477.        ; S1:15701
 *00074    :,     LOG,  00000000 00000000.        ; S1:15702
 *00075    :,     LOG,  00000000 00000002.        ; S1:15703
            ,     LOG,  77270707 00000000.        ; S1:15704
 *00077    :,     LOG,  00000000 00000000.        ; S1:15705
 *00100    :,     LOG,  00000000 00000000.        ; S1:15706
C  Диагностика «ERROR IN STANDARD ARRAY».
 *00101    :, ISO    ,6HERROR        ; S1:15707
            , ISO    ,6HIN STA        ; S1:15708
            , ISO    ,6HNDART        ; S1:15709
            , ISO    ,6HARRAY        ; S1:15710
C  Конец FORTLIBR.
 BSS       :     ,BSS,        ; S1:15711  BSS
      ,END,        ; S1:15712  END FORTLIBR

C----- 3. DATAPR*: печать даты DD MON YY HH.MM (S5:7645-7733) -----
C  Резидент MONSYS; вызывается корнем INITFOR* (S1:15479 / S2:0o510306).
C  Точки входа: DATAPR* (главная), DATE*, PREPDAT.
 DATAPR*:,NAME,        ; S5:7645
 DATA*:,LC,2        ; S5:7646  DATA*: LC 2 — 2-словный буфер даты
 DATAPR*:,BSS,.        ; S5:7647  главная точка входа
C  ПЕЧАТЬ ДАТЫ ПО ФОРМАТУ  DD MON 7Y HH.MM.
C-------------------------------------------        ; S5:7648
C ПEЧATЬ ДATЫ        ; S5:7649
C ПO ФOPMATY  DD MON 7Y HH.MM        ; S5:7650
C-------------------------------------------        ; S5:7651
C  Сохранение M13, настройка базы DARET.
 ,ITS,13        ; S5:7652  сохранить M13
 13,BASE,DARET        ; S5:7653  M13 <- база DARET
C  DATE*: ENTRY — получение даты/времени через FUN 67B.
 DATE*:,ENTRY,        ; S5:7654
 DATE*:,BSS,        ; S5:7655
 ,ITS,.        ; S5:7656
 ,FUN,67B.DD.MM.YY.HH.MM        ; S5:7657  FUN 67B — системная функция даты/времени
 ,NTR,6        ; S5:7658
 13,UJ,.        ; S5:7659  13,UJ,. — возврат через M13
C  DARET: разбор результата FUN 67B, выборка месяца из MARR.
 DARET:,BSS,        ; S5:7660
 ,XTS,DATE0        ; S5:7661
 15,XTS,-2        ; S5:7662
 ,AUX,DMASK        ; S5:7663
 ,ASN,64+16.        ; S5:7664
 ,AOX,DATE1        ; S5:7665
 15,XTS,-3        ; S5:7666
 ,AAX,MONTHFI        ; S5:7667
 ,ASN,64+35        ; S5:7668
 15,ATX,        ; S5:7669
 ,YTA,        ; S5:7670
 14,VTM,24        ; S5:7671
 ,UZA,L1        ; S5:7672
 14,VTM,        ; S5:7673
 L1:15,WTC,        ; S5:7674
C  MARR — таблица названий месяцев (ЯНВ … ДЕК).
 ,XTA,MARR        ; S5:7675  MARR — названия месяцев
 14,ASN,64        ; S5:7676
 ,ASN,64-24        ; S5:7677
 15,XTS,-4        ; S5:7678
 ,ASN,64-14.        ; S5:7679
 ,AUX,YMASK        ; S5:7680
 15,AOX,        ; S5:7681
 ,AOX,DATE2        ; S5:7682
 15,XTS,-4        ; S5:7683
 ,ASN,64-22.        ; S5:7684
 ,AUX,TMASK        ; S5:7685
 ,AOX,DATE3        ; S5:7686
 ,XTS,DATE4        ; S5:7687
 15,XTS,-8        ; S5:7688
 15,MTJ,13        ; S5:7689
 ,UZA,L2        ; S5:7690
 13,UTM,1        ; S5:7691
 L2:,UTC,L3        ; S5:7692
C  PRINT — вывод сформированной строки.
 ,PRINT,        ; S5:7693  PRINT — вывод строки
 15,UTM,-6        ; S5:7694
 15,XTA,        ; S5:7695
 ,STI,13        ; S5:7696
 13,UJ,        ; S5:7697
C  PREPDAT: ENTRY — подготовка даты и передача в DATAPR*.
 PREPDAT:,ENTRY,        ; S5:7698
 ,ITS,13.        ; S5:7699
 13,VJM,DATE*        ; S5:7700  VJM DATE*
 B:13,BAS,B        ; S5:7701
 15,ATX,        ; S5:7702
 ,ASN,64-14        ; S5:7703
 ,AUX,=6H'17''17'''''''''        ; S5:7704
 ,AOX,=6H00        ; S5:7705
 ,STX,DATA*+1        ; S5:7706
 ,AUX,=6H'3''17''''17''17'''        ; S5:7707
 ,AOX,=6H00/00/        ; S5:7708
 ,STX,DATA*        ; S5:7709
 ,STI,13        ; S5:7710
 ,UJ,DATAPR*        ; S5:7711  UJ DATAPR*
 L3:13,Z00,-5        ; S5:7712
 15,Z00,-1        ; S5:7713
C  GOST/ISO-константы формата даты.
 DATE0:,GOST,6H'201'  '200'7        ; S5:7714
 DATE1:,GOST,2H '200'        ; S5:7715
C ПOЗИЦИИ        ; S5:7716
 ,CONT,1H'055'        ; S5:7717
 ,CONT,3H00        ; S5:7718
 DATE2:,GOST,6H000 00.        ; S5:7719
 DATE4:,BSS,        ; S5:7720
 MARR:,GOST,6H'231'  ЯHB        ; S5:7721
 ,GOST,6HФEBMAP        ; S5:7722
 ,GOST,6HAПPMAЯ        ; S5:7723
 ,GOST,6HИЮHИЮЛ        ; S5:7724
 ,GOST,6HABГCEH        ; S5:7725
 DATE3:,GOST,6H 00.00        ; S5:7726
 DMASK:,BSS,.        ; S5:7727
 TMASK:,GOST,6H03 0        ; S5:7728
 YMASK:,GOST,6H0000  .        ; S5:7729
 ,GOST,6HOKTHOЯ        ; S5:7730
 ,GOST,6HДEK        ; S5:7731
 MONTHFI:,OCT,00 776        ; S5:7732
C  Конец DATAPR*.
 ,END,DATAPR*        ; S5:7733  END DATAPR*

C----- 4a. OCTTDEC: число → 6 ISO-цифр (S6:5042-5084) -----
C  Экспортируется модулем DECODER (S3:1181).
C  Вызывается корнем RMON (S1:15498 / S2:0o510322), TCATALOG,
C  OVERLOAD, SUMOVER (S3:1182-84).
 OCTTDEC :  ,NAME,        ; S6:5042
 C       :  ,BSS,        ; S6:5043
C  BEGIN: база C; CYCL — выделение 6 цифр делением на 10^k.
 BEGIN   :12,VTM,C                        .        ; S6:5044  BEGIN: M12 <- C (база)
            ,XTS,                         .        ; S6:5045
          12,STX,DEC-C                    .        ; S6:5046
          12,AAX,=777 7777-C        ; S6:5047  AAX =7777777-C — маска 6 цифр
          12,AOX,INT0-C                   .        ; S6:5048  AOX INT0-C — константа INT0
          12,ATX,OCT-C                    .        ; S6:5049
          14,VTM,-5        ; S6:5050
C  CYCL: NTR 3 / A/X / NTR 2 / A*X — вещественная арифметика.
 CYCL    :  ,NTR,                         .        ; S6:5051
          12,XTA,OCT-C                    .        ; S6:5052
          14,UTC,C1                       .        ; S6:5053
            ,A/X,                         .        ; S6:5054
            ,NTR,3                        .        ; S6:5055
          12,A+X,INT0-C                   .        ; S6:5056
          15,ATX,                         .        ; S6:5057
            ,NTR,2                        .        ; S6:5058
          14,UTC,C1                       .        ; S6:5059
            ,A*X,                         .        ; S6:5060
          12,X-A,OCT-C                    .        ; S6:5061
          12,STX,OCT-C                    .        ; S6:5062
          12,AAX,MASK15-C                 .        ; S6:5063
          12,AOX,DEC-C                    .        ; S6:5064
          14,VLM,/6SYMB        ; S6:5065
C  AOX ZERO — склейка ISO-кодов цифр; NTR 10; возврат через M13.
          12,AOX,ZERO-C                   .        ; S6:5066  AOX ZERO-C — добавить коды «0»
            ,NTR,10                       .        ; S6:5067
          13, UJ,                         .        ; S6:5068  13,UJ — возврат через M13
 /6SYMB  :  ,BSS,        ; S6:5069
            ,ASN,64-8                     .        ; S6:5070
          12,ATX,DEC-C                    .        ; S6:5071
            , UJ,CYCL        ; S6:5072
C  Константы: MASK15=77777, INT0=0, REAL 100000.0 … 1.0,
C  ZERO = «000000».
 OCT     :  ,OCT  ,                       .        ; S6:5073
 MASK15  :  ,OCT  ,0000000000077777       .        ; S6:5074  MASK15 = 0000000000077777
 INT0    :  ,INT  ,0        ; S6:5075  INT0 = 0
 DEC     :  ,OCT  ,                       .        ; S6:5076
         :  ,REAL,100000.0        ; S6:5077
         :  ,REAL ,10000.0                .        ; S6:5078
         :  ,REAL ,1000.0                 .        ; S6:5079
         :  ,REAL ,100.0                  .        ; S6:5080
         :  ,REAL ,10.0                   .        ; S6:5081
 C1      :  ,REAL ,1.0                    .        ; S6:5082  C1 = REAL 1.0
 ZERO    :  ,8TEXT,''000000''             .        ; S6:5083  ZERO = 8TEXT «000000»
C  Конец OCTTDEC (system2).
    ,END,        ; S6:5084  END

C----- 4b. OCTTDEC: вариант EXFOR (S7:427-459) -----
C  Тот же интерфейс, альтернативная реализация: умножение на 0.1
C  (C1/10) и C10; возврат через M15; ZERO = ISO 6H000000.
 OCTTDEC:,NAME,        ; S7:427
 14,BASE,*        ; S7:428  14,BASE,* — база M14
 ,AAX,B40/1        ; S7:429
 ,ITS,13        ; S7:430  ITS,13 — сохранить M13
 13,VTM,        ; S7:431
 ,NTR,3        ; S7:432  NTR 3 — вещественный режим
 ,XTS,        ; S7:433
 L1:15,XTS,-3        ; S7:434
 ,A*X,C1/10        ; S7:435  A*X,C1/10 — умножить на 0.1
 15,ATX,-3        ; S7:436
 ,YTA,64        ; S7:437
 ,A*X,C10        ; S7:438
 13,ASN,64        ; S7:439
 13,UTM,-4        ; S7:440
 15,AOX,        ; S7:441
 15,XTS,-3        ; S7:442
 ,UZA,RET        ; S7:443  UZA RET — конец цифр
 ,STX,        ; S7:444
 ,UJ,L1        ; S7:445
 RET:,STX,        ; S7:446  RET: STX
 15,UTM,-2        ; S7:447  15,UTM,-2 — сдвиг стека
 ,ASN,64-24        ; S7:448
 ,AUX,MSK        ; S7:449
 ,AOX,ZERO        ; S7:450
 ,NTR,2        ; S7:451
 15,WTC,1        ; S7:452  15,WTC,1
 ,UJ,        ; S7:453  UJ — возврат через M15
 B40/1:,LOG,17 7777 7777 7777        ; S7:454
 C10:,LOG,4000 0000 0000 0012        ; S7:455
 C1/10:,LOG,4001 4631 4631 4632        ; S7:456  C1/10 = LOG 4001 4631 4631 4632 (0.1)
 MSK:,GOST,6H        ; S7:457
 ZERO:,ISO,6H000000        ; S7:458  ZERO = ISO 6H000000
C  Конец OCTTDEC (exfor).
 ,END,        ; S7:459  END

