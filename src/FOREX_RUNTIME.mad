C----- 1. FT_FORMAT_DISPATCH (FORMAT): диспетчер таблицы входов FT* (S1:15529-15589) -----
C  Модуль не форматирует данные сам: он строит таблицу передач,
C  записывая адреса 11 подпрограмм FT* в ячейки 77xxxB (S3:206-216).
      FT_FORMAT_DISPATCH     :,NAME,  ; (FORMAT)        ; S1:15529
C  Объявлены 11 внешних подпрограмм: FT*571 … FT*003.
      FT*571     :,SUBP,        ; S1:15530
      FT*541     :,SUBP,        ; S1:15531
      FT*611     :,SUBP,        ; S1:15532
      FT*531     :,SUBP,        ; S1:15533
      FT*561     :,SUBP,        ; S1:15534
      FT*621     :,SUBP,        ; S1:15535
      FT*521     :,SUBP,        ; S1:15536
      FT*721     :,SUBP,        ; S1:15537
      FT*641     :,SUBP,        ; S1:15538
      FT*002     :,SUBP,        ; S1:15539
      FT*003     :,SUBP,        ; S1:15540
C  Настройка M14 и вычисление смещения в таблице передач.
                 ,ATI,  BASE_REG14        ; S1:15541  M14 <- acc: установка индексного регистра
            14 ,  XTA,        ; S1:15542  acc <- (M14)
                 ,ASN,  FT_ADDR_FIELD        ; S1:15543  ASN 103B: выделение поля адреса
                 ,YTA,        ; S1:15544
                 ,UTC,   FTD_CONST        ; S1:15545  UTC FTD_CONST: прибавить константу
                 ,AEX,        ; S1:15546
                 ,UIA,   FTD_OFFSET        ; S1:15547
            14 ,  XTA,        ; S1:15548
C  M12 = база 77766B; цикл VLM по M12 обходит таблицу.
 FTD_TABLE_BASE    :12 ,  VTM,  FTD_TABLE_BASE_ADDR        ; S1:15549  M12 <- база 77766B
                 ,UTC,        ; S1:15550
 FTD_LOOP    :     ,ATI,  BASE_REG14        ; S1:15551
            12 ,  WTC,   FTD_TABLE_END        ; S1:15552  WTC FTD_TABLE_END: модификатор адреса
            14 ,  UTM,        ; S1:15553
            14 ,  VZM,   FTD_STORE        ; S1:15554  VZM FTD_STORE: переход при нулевом M14
            12 ,  VLM,   FTD_LOOP        ; S1:15555  VLM FTD_LOOP: цикл по M12
                 , IJ,        ; S1:15556
C  Вычисление адреса очередной пары «UJ FT* / ATX 77xxxB».
 FTD_OFFSET    :     ,UTC,   FTD_CONST        ; S1:15557  формирование смещения (ASN 155B)
                 ,AEX,        ; S1:15558
                 ,ASN,  FT_OFFSET_MASK        ; S1:15559
                 , UJ,   FTD_TABLE_BASE        ; S1:15560
C  STX + ATI 14: запись и продвижение указателя таблицы.
 FTD_STORE    :     ,STX,        ; S1:15561
                 ,ATI,  BASE_REG14        ; S1:15562
            12 ,   UJ,   FTD_TABLE_END        ; S1:15563
                 ,UTC,        ; S1:15564
C  ТАБЛИЦА ПЕРЕХОДОВ: 11 пар UJ FT*nnn / ATX 77xxxB.
C  FT*571 реально экспортирует ANL (S3:1075), остальные 10 — FORMAT.
                 , UJ,  FT*571        ; S1:15565  FT*571 -> 77207B (импорт из ANL)
                 ,ATX,  FT571_DISPATCH        ; S1:15566
                 , UJ,  FT*541        ; S1:15567  FT*541 -> 77237B
                 ,ATX,  FT541_DISPATCH        ; S1:15568
                 , UJ,  FT*611        ; S1:15569  FT*611 -> 77167B
                 ,ATX,  FT611_DISPATCH        ; S1:15570
                 , UJ,  FT*531        ; S1:15571  FT*531 -> 77247B
                 ,ATX,  FT531_DISPATCH        ; S1:15572
                 , UJ,  FT*561        ; S1:15573  FT*561 -> 77217B
                 ,ATX,  FT561_DISPATCH        ; S1:15574
                 , UJ,  FT*621        ; S1:15575  FT*621 -> 77157B
                 ,ATX,  FT621_DISPATCH        ; S1:15576
                 , UJ,  FT*521        ; S1:15577  FT*521 -> 77257B
                 ,ATX,  FT521_DISPATCH        ; S1:15578
                 , UJ,  FT*721        ; S1:15579  FT*721 -> 77057B
                 ,ATX,  FT721_DISPATCH        ; S1:15580
                 , UJ,  FT*641        ; S1:15581  FT*641 -> 77137B
                 ,ATX,  FT641_DISPATCH        ; S1:15582
                 , UJ,  FT*002        ; S1:15583  FT*002 -> 77776B
                 ,ATX,  FT002_DISPATCH        ; S1:15584
 FTD_TABLE_END    :     , UJ,  FT*003        ; S1:15585  FT*003 -> 77775B
                 ,ATX,  FT003_DISPATCH        ; S1:15586
C  Константы и конец модуля.
 FTD_CONST    :,     LOG,  LIT_10000000_00000000.        ; S1:15587  FTD_CONST: LOG 10000000 00000000
 BSS       :     ,BSS,        ; S1:15588
      ,END,        ; S1:15589  END FORMAT

C----- 2. FT_LIBRARY_IO (FORTLIBR): PRINT8 / WRITLIBR (S1:15590-15712) -----
C  Экспорт: PRINT8 (S3:217), WRITLIBR (S3:1313).
C  FT_LIB_BUFFER PU 2000B — буфер обмена с библиотекой.
      FT_LIBRARY_IO   :,NAME,  ; (FORTLIBR)        ; S1:15590
      FT_LIB_BUFFER     :,PU,  LIB_BUFFER_LEN        ; S1:15591  FT_LIB_BUFFER: PU 2000B (0o2000 слов)
      WRITLIBR   :,SUBP,        ; S1:15592  SUBP — точка входа (экспорт)
      PRINT8     :,SUBP,        ; S1:15593  SUBP — точка входа (экспорт)
C  PRINT8: печать 8-символьного ISO-слова; M14/M7/M13 — рабочие.
            14 ,  VTM,   FL_CONST_BASE        ; S1:15594  M14 <- FL_CONST_BASE (база констант)
L           14 ,  ATX,   *00077    - FL_CONST_BASE        ; S1:15595
                 ,ITA,  DEC_7        ; S1:15596
                 ,ITS,  RET_LINK_REG        ; S1:15597
             7 ,  VTM,   FL_CONST_BASE        ; S1:15598
L            7 ,  XTS,   *00064    - FL_CONST_BASE        ; S1:15599
L            7 ,  ATX,   *00100    - FL_CONST_BASE        ; S1:15600
            14 ,  VTM,   *00014        ; S1:15601
                 ,ITA,  BASE_REG14        ; S1:15602
C  VJM WRITLIBR+1 — вызов подготовительной части WRITLIBR.
L           13 ,  VJM,   WRITLIBR  +1        ; S1:15603  VJM WRITLIBR+1
                 ,UIA,   FL_AFTER_WRITE        ; S1:15604
                 ,STI,        ; S1:15605
                 ,STI,  RET_LINK_REG        ; S1:15606
                 ,STI,  DEC_7        ; S1:15607
            13 ,   UJ,        ; S1:15608
                 ,UTC,        ; S1:15609
 FL_AFTER_WRITE    :14 ,  VTM,   *00101        ; S1:15610
                 ,ITS,  BASE_REG14        ; S1:15611
            14 ,  UTM,  REAL_MODE_3        ; S1:15612
                 ,ITS,  BASE_REG14        ; S1:15613
                 ,ITS,        ; S1:15614
C  VJM PRINT8 — печать подготовленного слова.
            13 ,  VJM,  PRINT8        ; S1:15615  VJM PRINT8
                 , *74,        ; S1:15616
C  WRITLIBR: проверки и сборка выходного слова в FT_LIB_BUFFER.
 *00014    :     ,ITS,  DEC_7        ; S1:15617
             7 ,  VTM,   FL_CONST_BASE        ; S1:15618
             7 ,  ATX,        ; S1:15619
C  M14 = FT_LIB_BUFFER: адрес буфера.
            14 ,  VTM,  FT_LIB_BUFFER        ; S1:15620  M14 <- FT_LIB_BUFFER
                 ,ITA,  BASE_REG14        ; S1:15621
L            7 ,  ATX,   *00071    - FL_CONST_BASE        ; S1:15622
                 ,UTC,   *00100        ; S1:15623
                 ,XTA,        ; S1:15624
                 ,UZA,   FL_SIGN_CHECK        ; S1:15625
L            7 ,  ATX,   *00062    - FL_CONST_BASE        ; S1:15626
                 ,XTA,        ; S1:15627
L            7 ,  ATX,   *00063    - FL_CONST_BASE        ; S1:15628
                 ,UTC,   *00100        ; S1:15629
                 ,ATX,        ; S1:15630
L*00023    : 7 ,  XTA,   *00062    - FL_CONST_BASE        ; S1:15631
                 ,UZA,   FL_COMPARE        ; S1:15632
L            7 ,  XTA,   *00063    - FL_CONST_BASE        ; S1:15633
                 ,UIA,   FL_WTC_CASE        ; S1:15634
C  WTC *00077 — установка модификатора адреса.
                 ,WTC,   *00077        ; S1:15635  WTC *00077
                 ,XTA,        ; S1:15636
                 ,AEX,        ; S1:15637
                 ,UZA,   FL_ALT_CASE        ; S1:15638
L*00027    : 7 ,  XTS,   *00063    - FL_CONST_BASE        ; S1:15639
L            7 ,  AEX,   *00064    - FL_CONST_BASE        ; S1:15640
L            7 ,  STX,   *00063    - FL_CONST_BASE        ; S1:15641
             7 ,  XTS,        ; S1:15642
                 ,STI,  DEC_7        ; S1:15643
            13 ,   UJ,        ; S1:15644
 FL_WTC_CASE    :     ,WTC,   *00077        ; S1:15645
                 ,XTA,  ONE_WORD        ; S1:15646
L            7 ,  XTS,   *00077    - FL_CONST_BASE        ; S1:15647
L            7 ,  ARX,   *00075    - FL_CONST_BASE        ; S1:15648
L            7 ,  ATX,   *00077    - FL_CONST_BASE        ; S1:15649
                 ,STX,        ; S1:15650
                 , UJ,   FL_XOR_LOOP        ; S1:15651
                 ,UTC,        ; S1:15652
 FL_ALT_CASE    :     ,WTC,   *00077        ; S1:15653
                 ,XTA,  ONE_WORD        ; S1:15654
L            7 ,  ATX,   *00065    - FL_CONST_BASE        ; S1:15655
                 ,XTA,        ; S1:15656
L            7 ,  ATX,   *00062    - FL_CONST_BASE        ; S1:15657
L            7 ,  ATX,   *00072    - FL_CONST_BASE        ; S1:15658
L            7 ,  ATX,   *00074    - FL_CONST_BASE        ; S1:15659
                 , UJ,   FL_COMPARE        ; S1:15660
L*00042    : 7 ,  ARX,   *00071    - FL_CONST_BASE        ; S1:15661
L            7 ,  ATX,   *00072    - FL_CONST_BASE        ; S1:15662
