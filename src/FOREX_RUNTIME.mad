L            7 ,  ATX,   *00074    - FL_CONST_BASE        ; S1:15665
                 ,UTC,        ; S1:15666
L*00045    : 7 ,  XTA,   *00072    - FL_CONST_BASE        ; S1:15667
L            7 ,  AEX,   *00071    - FL_CONST_BASE        ; S1:15668
                 ,UZA,   FL_MASK_CASE        ; S1:15669
L            7 ,  AAX,   *00066    - FL_CONST_BASE        ; S1:15670
                 ,UZA,   FL_ASSEMBLE        ; S1:15671
                 ,UTC,        ; S1:15672
L*00050    : 7 ,  XTA,   *00072    - FL_CONST_BASE        ; S1:15673
L            7 ,  ARX,   *00064    - FL_CONST_BASE        ; S1:15674
L            7 ,  ATX,   *00072    - FL_CONST_BASE        ; S1:15675
                 ,WTC,   *00072        ; S1:15676
                 ,XTA,  ALL_ONES_MASK        ; S1:15677  XTA 77777B — маска
                 , UJ,   FL_XOR_LOOP        ; S1:15678
L*00053    : 7 ,  XTA,   *00065    - FL_CONST_BASE        ; S1:15679
L            7 ,  ARX,   *00074    - FL_CONST_BASE        ; S1:15680
L            7 ,  AAX,   *00073    - FL_CONST_BASE        ; S1:15681
L            7 ,  AOX,   *00067    - FL_CONST_BASE        ; S1:15682
L            7 ,  ATX,   *00070    - FL_CONST_BASE        ; S1:15683
C  Экстракод *70 и сдвиг ASN 54B — сборка 8-символьного слова.
L            7 ,  XTS,   *00071    - FL_CONST_BASE        ; S1:15684  ASN 54B
                 ,ASN,  ISO_CODE_SHIFT        ; S1:15685
            15 ,  AOX,        ; S1:15686
L            7 ,  ATX,   *00070    - FL_CONST_BASE        ; S1:15687
L            7 ,   *70,  *00070    - FL_CONST_BASE        ; S1:15688  *70 — экстракод
                 ,XTA,        ; S1:15689
                 , UJ,   FL_SHIFT_IN        ; S1:15690
 FL_CONST_BASE    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15691
 *00062    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15692
 *00063    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15693
 *00064    :,     LOG,  DATA_WORD_00000000_00000001.        ; S1:15694
 *00065    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15695
 *00066    :,     LOG,  DATA_WORD_00000000_00001777.        ; S1:15696
 *00067    :,     LOG,  DATA_WORD_00100000_00000000.        ; S1:15697
 *00070    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15698
 *00071    :,     LOG,  DATA_WORD_00000000_00000000.        ; S1:15699
