C     O412B -- EMIT M80/4.12 *TRANS CATALOG + BODY PREFIX (M4d)
C=======================================================================
C Copy-only extension of src/newcomp/EMIT.FTN (repo file untouched).
C Sixth program unit added to the existing /EMBUF/ common area.
C
C CORRECTIONS FROM THE REAL TRNSLTOR SOURCE AND THE M80 LIVE DISASM:
C  * f0 = low 12-bit descriptor field, isolated by AAX with mask 0o7777
C    at NEWCOMP* pc=0o3040 and XOR-compared with 0o1760 at pc=0o3046.
C    It is NOT an M16 base register (M16 in MONSYS is a bit flag).
C  * f0=0o1760 is required in the CATALOG descriptor, not in body cmd.
C  * Body cmd length need not be 0o1760; live header is proven base.
C  * B5 (UIA 1760(M16)/UJ 464) is loader DATA: M80 trace shows
C    AU=7240176003000464 at pc=0o736; it is not our entry code.
C  * Catalog word 0o12 is ISO OVERLA, 0o13..0o16 build comment.
C  * Final jump: pc=0o00455 VJM 0o64002 (loaded compiler entry).
C
C Output (1-based /EMBUF/ indices):
C   1..16  catalog zone N (live M80 layout, name OURMRK*)
C   17..   body zone N+1 (B0 service, live header, marker, stub,
C          loader words; host fills the rest from live 4.12).
C Host fills zones N+2.. from the proven live 4.12 overlay body.
C F77 subset: no IMPLICIT, no CHARACTER, names <=6 chars, <=72 cols.
C=======================================================================
       SUBROUTINE O412B
       INTEGER HI(32), LO(32), NW
       COMMON /EMBUF/ HI,LO,NW
       INTEGER OD(8)
       COMMON /OCTBF/ OD
       INTEGER I
       PRINT 90
   90 FORMAT(1X,'O412B-412')
       NW = 0
C-- K0 TEXT MONITOR*
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 11991977
       LO(NW) = 13827210
C-- K1 desc 0o370
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 0
       LO(NW) = 248
C-- K2 TEXT OURMRK*
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 12541101
       LO(NW) = 13283968
C-- K3 desc f0=0o1760
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 1050647
       LO(NW) = 12354544
C-- K4 TEXT LO*SYN
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 11727539
       LO(NW) = 15130624
C-- K5 LO*SYN desc
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 1054878
       LO(NW) = 15479657
C-- K6 TEXT LO*GEN
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 11727527
       LO(NW) = 9887744
C-- K7 LO*GEN desc
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 1085598
       LO(NW) = 7353193
C-- K10 zero (catalog terminator)
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 0
       LO(NW) = 0
C-- K11 desc 417050000000000
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 1110336
       LO(NW) = 0
C-- K12 ISO OVERLA
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 5199429
       LO(NW) = 5393473
C-- K13 comment
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 1646671
       LO(NW) = 5513248
C-- K14 comment
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 3290926
       LO(NW) = 3159598
C-- K15 comment
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 3683616
       LO(NW) = 5059360
C-- K16 comment
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 3947565
       LO(NW) = 2965054
C-- K17 zero
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 0
       LO(NW) = 0
C-- B0 service 0o1600043
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 0
       LO(NW) = 458787
C-- B1 live w0
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 10157221
       LO(NW) = 14758528
C-- B2 live w1
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 16320
       LO(NW) = 2127615
C-- B3 live w2
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 9344
       LO(NW) = 1008
C-- B4 marker 0o73461
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 0
       LO(NW) = 30513
C-- B5 loader stub (DATA)
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 15336432
       LO(NW) = 786740
C-- B6 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 16320
       LO(NW) = 2127615
C-- B7 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 19840
       LO(NW) = 13161
C-- B10 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 15872
       LO(NW) = 132088
C-- B11 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 139277
       LO(NW) = 1034
C-- B12 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 33806
       LO(NW) = 1043
C-- B13 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 33808
       LO(NW) = 1044
C-- B14 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 33805
       LO(NW) = 1045
C-- B15 live word
       CALL EMIT48(0,0,0, 0,0,0)
       HI(NW) = 33807
       LO(NW) = 1046
       PRINT 91, NW
   91 FORMAT(1X,'O412BNW ',I3)
       DO 10 I = 1, NW
          CALL OCT8(HI(I))
          PRINT 100, I, OD(8),OD(7),OD(6),OD(5),OD(4),OD(3),OD(2),OD(1)
          CALL OCT8(LO(I))
          PRINT 101, I, OD(8),OD(7),OD(6),OD(5),OD(4),OD(3),OD(2),OD(1)
          PRINT 102, I, HI(I), LO(I)
   10 CONTINUE
  100 FORMAT(1X,'O412W ',I2,' HI ',8I1)
  101 FORMAT(1X,'O412W ',I2,' LO ',8I1)
  102 FORMAT(1X,'O412D ',I2,2I10)
       RETURN
       END
       SUBROUTINE EMIT48(IR1,K1,A1,IR2,K2,A2)
       INTEGER IR1,K1,A1,IR2,K2,A2
       INTEGER HI(32), LO(32), NW
       COMMON /EMBUF/ HI,LO,NW
       NW = NW + 1
       HI(NW) = IR1*2097152 + K1*32768 + A1
       LO(NW) = IR2*2097152 + K2*32768 + A2
       RETURN
       END
       SUBROUTINE OCT8(X)
       INTEGER X, OD(8), Q, I
       COMMON /OCTBF/ OD
       Q = X
       DO 30 I = 1, 8
          OD(I) = Q - (Q/8)*8
          Q = Q/8
   30 CONTINUE
       RETURN
       END
