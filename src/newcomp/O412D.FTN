C     O412D -- EMITTER: BODY ZONE N+1 TAIL WORDS
C===============================================================
C All words emitted by OUR Fortran program (FOREX 2.02).
C    tail words 19..1023 of body zone N+1
C F77 subset, <=72 cols.
C===============================================================
      SUBROUTINE DRIVER
      INTEGER HI(1100), LO(1100), NW
      COMMON /EMBUF/ HI,LO,NW
      PRINT 90
   90 FORMAT(1X,'O412D-412')
      NW = 0
      CALL EMT00
      CALL EMT01
      CALL EMT02
      CALL EMT03
      CALL DUMP
      RETURN
      END
