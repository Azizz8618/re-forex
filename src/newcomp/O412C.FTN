      END
      SUBROUTINE OCT8(X)
      INTEGER X, OD(8), Q, I
      COMMON /OCTBF/ OD
      Q = X
      DO 30 I = 1, 8
         OD(I) = Q - (Q/8)*8
         Q = Q/8
   30 CONTINUE
      RETURN
      END
