C  VERSION STAMP FOREX 5.00 / 19.11.2026 (re-forex); host banner 2.02 is external
C***********************************************************************
C* FOREX_DECODER_DISASM — скомпилированные тела внешних подпрограмм       *
C*                         DATE_PRINT (DATAPR*) и OCT_DEC (OCTTDEC)       *
C*                                                                       *
C* СОСТАВ (три секции; каждая — подлинный МАДЛЕН-исходник Дубны,          *
C*         скомпилированный DTRAN 01.06.84 через dispak и дизассембли-    *
C*         рованный обратно; машинные слова сверены с build/RUNTIME_*):  *
C*   1 DPRNT  — DATAPR*, печать даты DD MON YY HH.MM   S5:7645-7733       *
C*   2 OCTDC  — OCTTDEC (DECODER/MONSYS), число → 6 ISO-цифр S6:5042-5084 *
C*   3 OCTEX  — OCTTDEC (EXFOR, 08.12.80), вариант       S7:427-459       *
C*                                                                       *
C* ПРОИСХОЖДЕНИЕ / ИСТОЧНИКИ:                                             *
C*  S5 /home/azizz/besm6.github.io/sources/dubna/besmmons/system1.txt     *
C*  S6 /home/azizz/besm6.github.io/sources/dubna/besmmons/system2.txt     *
C*  S7 /home/azizz/besm6.github.io/sources/dubna/besmtask/exfor.vv        *
C*  LINK-ячейки 0o74010=DATAPR*, 0o74013=OCTTDEC подтверждены              *
C*     docs/06-address-map.md §3; там же 0o74011=TAK/PG, 0o74012=GIV/PG. *
C*                                                                       *
C* ПОИСК ТЕЛ НА ЛЕНТЕ (отрицательный результат, честно):                  *
C*  monsys.9 0o74000..0o74047 — 40 IDENTICAL `yta,ati 15` (LINK-заглушки; *
C*    Confirmation от родительского агента). Тел там НЕТ.                 *
C*  13 DMS-заголовков 0o200003 на ленте: CBDPR/CONTROL/ENDPRO/GLINK/       *
C*     A/PRINTM/BCDAPRT*/F/OPT/ERRDIAG*/LO*SYN/LO*GEN/TASK73 — имен       *
C*     DATAPR*/OCTTDEC среди них нет.                                     *
C*  Имена DATAPR*/OCTTDEC встречаются 25 раз каждый — это LIBREFER-       *
C*     каталоги (напр. 0o536167/0o536172, 0o610053/0o610066), не тела.    *
C*  Пул констант EXFOR-варианта найден на ленте 0o411311-0o411333         *
C*     (B40/1=0o411316, C10=0o411327, C1/10=0o411332) — скомпилированный *
C*     фрагмент OCTTDEC в поле 4. его код/константы сверены с S7.         *
C*     Тела же полной формы (с data-таблицами) на ленте не найдены.       *
C*  => тела получены компиляцией авторских исходников Дубны через DTRAN   *
C*     в эмуляторе dispak (WORKVOL=80, LIBRA:2), с последующей поразрядной *
C*     перекодировкой листинга DTRAN в build/RUNTIME_*.words.              *
C*                                                                       *
C* ИМЕНОВАНИЕ МЕТОК (требование родителя): все метки и EQU ≤6 символов,   *
C* первые 6 уникальны. Полное осмысленное имя — в комментарии и в xref    *
C* ниже. Префиксы: DP* = DATE_PRINT, OS* = OCT_DEC/SYSTEM2,               *
C* OX* = OCT_DEC/EXFOR, O* (без префикса) = общие константы OCT.          *
C***********************************************************************

C ---- КОНСТАНТЫ/ЛИТЕРАЛЫ (все числовые операнды -> ,EQU,) ----
C------ DATAPR*: регистры, сдвиги, immediate ---------------------------
DR13    ,EQU, 13                  ; M13 — базовый регистр DATE_PRINT; S5:7646
DR14    ,EQU, 14                  ; M14 — регистр BASE/DARET; S5:7646
DR15    ,EQU, 15                  ; M15 — рабочий регистр; S5:7661
D64P16  ,EQU, 64+16               ; сдвиг DD из FUN 67B (64+16 = 80 dec, без B — десятичное); S5:7664  ; DATE_DAY_SHIFT
D64P35  ,EQU, 64+35               ; сдвиг MM из FUN 67B (64+35 = 99 dec, без B — десятичное); S5:7668  ; DATE_MONTH_SHIFT
D64M24  ,EQU, 64-24               ; индекс месяца; S5:7677  ; DATE_MONTH_INDEX_SHIFT
D64M14  ,EQU, 64-14               ; сдвиг YY; S5:7679  ; DATE_YEAR_SHIFT
D64M22  ,EQU, 64-22               ; сдвиг HH.MM; S5:7684  ; DATE_TIME_SHIFT
DS06    ,EQU, 6                   ; NTR 6 — число полей даты; S5:7658
DS03    ,EQU, 3                   ; NTR 3; S5:7665
DS02    ,EQU, 2                   ; NTR 2; S5:7674
DS01    ,EQU, 1                   ; UTM 1 / MTJ 13; S5:7690
DS24    ,EQU, 24                  ; VTM 24; S5:7673
DS16    ,EQU, 16                  ; сдвиг 64+16 компонента (64+16 = 80 dec, без B — десятичное); S5:7664
DS00    ,EQU, 0                   ; нулевой индекс; S5:7645
DN02    ,EQU, -2                  ; XTS -2 (DATE*); S5:7659
DN03    ,EQU, -3                  ; XTS -3 (MONTHFI); S5:7663
DN04    ,EQU, -4                  ; XTS -4; S5:7676
DN06    ,EQU, -6                  ; UTM -6; S5:7694
DN08    ,EQU, -8                  ; XTS -8; S5:7688
DN01    ,EQU, -1                  ; Z00 -1; S5:7704
DN05    ,EQU, -5                  ; Z00 -5; S5:7703
DV067   ,EQU, 67B                 ; *50 67B — FUN 67B системная дата; S5:7657
DV032   ,EQU, 32B                 ; XS-индекс DATE0; S5:7659  ; (=0o32)
DV043   ,EQU, 43B                 ; индекс MONTHFI; S5:7663
DV033   ,EQU, 33B                 ; индекс DATE1; S5:7664
DV047   ,EQU, 47B                 ; индекс MARR; S5:7670
DV030   ,EQU, 30B                 ; VTM 30B; S5:7672
DV035   ,EQU, 35B                 ; индекс YMASK; S5:7678
DV044   ,EQU, 44B                 ; индекс DATE2; S5:7683
DV034   ,EQU, 34B                 ; индекс TMASK; S5:7685
DV024   ,EQU, 24B                 ; индекс DATE3; S5:7687
DV027   ,EQU, 27B                 ; индекс DATE4; S5:7688
DV025   ,EQU, 25B                 ; AUX 25B в PREPDAT; S5:7700
DV026   ,EQU, 26B                 ; AOX 26B в PREPDAT; S5:7700
DV012   ,EQU, 12B                 ; ATX 12B; S5:7699
DV013   ,EQU, 13B                 ; ATX 13B; S5:7701
DV014   ,EQU, 14B                 ; UTM 14B; S5:7690
DV773   ,EQU, 7773B               ; AMX 7773B; S5:7708  ; (=0o7773)
DV777   ,EQU, 7777B               ; AMX 7777B; S5:7709  ; (=0o7777)
DFUN67  ,EQU, 67                  ; FUN 67B код экстракода даты; S5:7657
C------ DATAPR*: DOUBLE WORD-ЛИТЕРАЛЫ (см. машинные слова ниже) ---------
DW00    ,EQU, 4020741740003417    ; ISO '201' '200'7; DATE0; S5:7707
DW01    ,EQU, 3700055000000017    ; ISO '055' + DATE1 '200'; S5:7707-7708
DW02    ,EQU, 0000000003600000    ; CONT 1H'055'; S5:7709
DW03    ,EQU, 4620741717426442    ; ISO '231' ЯHB; MARR; S5:7712
DW04    ,EQU, 150224421302006     ; GOST ФEBMAP; MARR+1; S5:7713
DW05    ,EQU, 1720000000000000    ; GOST АПPMAЯ; MARR+2; S5:7714
DW06    ,EQU, 0000000000000000    ; GOST ИЮHИЮЛ; MARR+3; S5:7715
DW07    ,EQU, 1002104314222455    ; GOST ABГCEH; MARR+4; S5:7716
DW10    ,EQU, 0000003600000034    ; GOST ' 00.00'; DATE3; S5:7718
DW11    ,EQU, 0000141700007417    ; TMASK 6H03 0; S5:7720
DW12    ,EQU, 0000000000007417    ; DMASK (BSS .); S5:7719
