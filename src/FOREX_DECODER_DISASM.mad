C***********************************************************************
C 1. DPRNT — DATE_PRINT (DATAPR*), S5:7645-7733
C    полное имя: DATE_PRINT; LINK 0o74010; точка входа INIT_FOREX S1:15479
C***********************************************************************
      DPRNT   :,NAME,  ; полное имя: DATE_PRINT  ; DATAPR*  ; S5:7645
      DPDAT   ,LC,2    ; полное имя: DATE_BLOCK (DATA*), 2 слова; S5:7646
      DPP8    ,SUBP,   ; полное имя: PRINT8 (макрос ,PRINT,); S5:7695

C Слово 0000 @0o000000 = 0o0000000000200003  (DMS-маркер, см. build/RUNTIME_DATAPR.words)
C Слово 0001 @0o000001 = 0o4441644160621200  (TEXT 'DATAPR*')
DP000   ,BSS,.        ; точка входа DATAPR* ( метка *0000B DTRAN ); S5:7647
        ,ITS,DR13     ; ITS 13 — сохранить базу; S5:7647
        ,VTM,DP003    ; VTM *0003B — перейти к DARET; S5:7648

DP001   ,ENTRY,       ; DATE* — полное имя: DATE_GET; S5:7654
C Слово 0004 @0o000004 = 0o0037000667000000  (вход DATE*)
        ,ITS,DS00     ; ITS без аргумента; S5:7655
        ,*50,DV067    ; FUN 67B — DD.MM.YY.HH.MM; S5:7657 . Э50 67 = СЕРВИСНЫЕ ЭКСТРАКОДЫ И ЭЛЕМЕНТАРНЫЕ ФУНКЦИИ (ИР 050 A), стр.264 [tyurin1985]
        ,NTR,DS06     ; NTR 6; S5:7658
        ,UJ,DP001     ; UJ DATE* (возврат); S5:7660

DP003   ,BSS,.        ; DARET — полное имя: DATE_PARSE; S5:7661
C Слово 0005 @0o000005 = 0o6403003274037776
        ,XTS,DV032    ; XTS 32B — DATE0; S5:7662
        ,XTS,DN02     ; XTS -2; S5:7659
        ,AUX,DV043    ; AUX 43B — MONTHFI; S5:7663  ; DV043 = аргумент = код DD из даты (младшие разряды) = 43, не адрес [besmmons/system1.txt:7663,7682,7700; src/FOREX_DECODER_DISASM.mad:67,72,76,164,184,213]
        ,ASN,D64P16   ; ASN 64+16 — выделить DD; S5:7664
        ,AOX,DV033    ; AOX 33B — DATE1; S5:7664
        ,XTS,DN03     ; XTS -3; S5:7663
        ,AAX,DV047    ; AAX 47B — MARR; S5:7670
        ,ASN,D64P35   ; ASN 64+35 — выделить MM; S5:7668
        ,ATX,DS00     ; ATX — записать; S5:7669
        ,YTA,DS00     ; YTA; S5:7670
        ,VTM,DS24     ; VTM 24; S5:7673
        ,UZA,DP012    ; UZA L1; S5:7674
        ,VTM,DS00     ; VTM; S5:7675

DP012   ,BSS,.        ; L1 — метка цикла вывода даты; S5:7677
C Слово 0015 @0o000015 = 0o0036005074037774
        ,WTC,DS00     ; WTC; S5:7677
        ,XTA,DV035    ; XTA 35B — YMASK; S5:7678
        ,ASN,DR15     ; ASN 64 (через M15); S5:7678
        ,ASN,D64M24   ; ASN 64-24 — индекс месяца; S5:7677
        ,XTS,DN04     ; XTS -4; S5:7676
        ,ASN,D64M14   ; ASN 64-14 — YY; S5:7679
        ,AUX,DV044    ; AUX 44B — DATE2; S5:7682  ; DV044 = аргумент = код DD из даты (младшие разряды) = 44, не адрес [besmmons/system1.txt:7663,7682,7700; src/FOREX_DECODER_DISASM.mad:67,72,76,164,184,213]
        ,AOX,DS00     ; AOX; S5:7682
        ,AOX,DV034    ; AOX 34B — DATE3; S5:7685
        ,XTS,DN04     ; XTS -4; S5:7685
        ,ASN,D64M22   ; ASN 64-22 — HH.MM; S5:7684
        ,AUX,DV043    ; AUX 43B — MONTHFI; S5:7686  ; DV043 = аргумент = код DD из даты (младшие разряды) = 43, не адрес [besmmons/system1.txt:7663,7682,7700; src/FOREX_DECODER_DISASM.mad:67,72,76,164,184,213]
        ,AOX,DV024    ; AOX 24B — DATE4; S5:7687
        ,XTS,DV035    ; XTS 35B — YMASK; S5:7688
        ,XTS,DN08     ; XTS -8; S5:7688
        ,MTJ,DR13     ; MTJ 13; S5:7689
        ,UZA,DP023    ; UZA L2; S5:7690
        ,UTM,DS01     ; UTM 1; S5:7690

DP023   ,BSS,.        ; L2 — метка печати; S5:7691
        ,UTC,DP034    ; UTC L3; S5:7692
        ,*64,DS00     ; экстракод *64; S5:7692 . Э64 0 = Отмена режима яистования при печати, стр.277 [tyurin1985]
        ,UTM,DN06     ; UTM -6; S5:7694
        ,XTA,DS00     ; XTA; S5:7694
        ,STI,DR13     ; STI 13; S5:7695
        ,UJ,DS00      ; UJ (возврат); S5:7696

DP026   ,ENTRY,       ; PREPDAT — полное имя: DATE_PREPARE; S5:7698
        ,ITS,DR13     ; ITS 13; S5:7698
        ,VJM,DP001    ; VJM DATE*; S5:7699
        ,ATX,DS00     ; ATX; S5:7699
        ,ASN,D64M14   ; ASN 64-14; S5:7699
        ,AUX,DV024    ; AUX 24B  ; DV024 = аргумент = код DD из даты (младшие разряды) = 24, не адрес [besmmons/system1.txt:7663,7682,7700; src/FOREX_DECODER_DISASM.mad:67,72,76,164,184,213]
        ,AOX,DV027    ; AOX 27B
        ,STX,DPDAT+1  ; STX DATA*+1; S5:7700
        ,AUX,DV025    ; AUX 25B  ; DV025 = аргумент = код DD из даты (младшие разряды) = 25, не адрес [besmmons/system1.txt:7663,7682,7700; src/FOREX_DECODER_DISASM.mad:67,72,76,164,184,213]
        ,AOX,DV026    ; AOX 26B
        ,STX,DPDAT    ; STX DATA*; S5:7701
        ,STI,DR13     ; STI 13; S5:7702
        ,UJ,DP000     ; UJ DATAPR*; S5:7702

DP034   ,BSS,.        ; L3 — метка выхода; S5:7703
        ,AMX,DV773    ; AMX 7773B; S5:7703
        ,AMX,DV777    ; AMX 7777B; S5:7704
C ---- DOUBLE WORD-ЛИТЕРАЛЫ DATAPR* (побайтовые метки) -------------------
C Слово 0035 @0o000035 = 0x4020741740003417 -> DW00
        ,LOG,DW00     ; DATE0 '201' '200'7; S5:7707
        ,LOG,DW01     ; DATE1 / '055'; S5:7707
        ,LOG,DW02     ; CONT 1H'055'; S5:7709
        ,LOG,DW03     ; MARR '231' ЯHB; S5:7712
        ,LOG,DW04     ; MARR ФEBMAP; S5:7713
        ,LOG,DW05     ; MARR АПPMAЯ; S5:7714
        ,LOG,DW06     ; MARR ИЮHИЮЛ; S5:7715
        ,LOG,DW07     ; MARR ABГCEH; S5:7716
        ,LOG,DW10     ; DATE3 ' 00.00'; S5:7718
        ,LOG,DW11     ; TMASK 03 0; S5:7720
        ,LOG,DW12     ; DMASK (BSS); S5:7719
        ,LOG,DW13     ; YMASK 0000  .; S5:7721
        ,LOG,DW14     ; OKTHOЯ; S5:7722
        ,LOG,DW15     ; MONTHFI 00 776; S5:7724
        ,LOG,DW16     ; константа 0o36074; S5:7723
        ,LOG,DW17     ; =6H'3''17''17''17'; S5:7701
        ,LOG,DW20     ; =6H'17''17''''''''; S5:7700
      ,END,DPRNT      ; S5:7733 END DATAPR*

