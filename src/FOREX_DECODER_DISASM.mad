C XREF — перекрёстные ссылки (полные имена; см. include/RUNTIME_DECODER.xref.md)
C  DPRNT  = DATE_PRINT (DATAPR*)        LINK 0o74010; зовёт INIT_FOREX S1:15479
C  DP001  = DATE_GET    (DATE*)          entry; зовёт DATE_PREPARE S5:7699
C  DP003  = DATE_PARSE  (DARET)          entry; парсит FUN 67B
C  DP026  = DATE_PREPARE(PREPDAT)        entry; зовёт DATE_GET
C  DPP8   = PRINT8                       внешний (макрос ,PRINT,)
C  OCTDC  = OCT_DEC (DECODER, OCTTDEC)   LINK 0o74013; зовёт PRINT_TIME S1:15498
C  OCTEX  = OCT_DEC_EXFOR (OCTTDEC/EXFOR) альтернатива; пул 0o411311-0o411333
C  DPDAT  = DATE_BLOCK (DATA*)           2-словный блок DATAPR*
C  OS003  = OCT_CYCLE  (CYCL)             цикл DEC-преобразования
C  OS6SY  = OCT_6SYMB  (/6SYMB)           подпрограмма 6 символов
C  OXRET  = OCT_EXFOR_RETURN (RET)        возврат EXFOR-варианта
C  Внешние вызывающие (по S3 LIBREFER): FOREX*, TCATALOG, OVERLOAD, SUMOVER
