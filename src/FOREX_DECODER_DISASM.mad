        ,XTS,DS00      ; XTS; S6:5045
        ,STX,OSDEC-OS000; STX DEC-C; S6:5046
        ,AAX,OMSK15    ; AAX =777 7777-C; S6:5047
        ,AOX,OSINT     ; AOX INT0-C; S6:5048
        ,ATX,OSOCT     ; ATX OCT-C; S6:5049
        ,VTM,ON04      ; VTM -5; S6:5050
OS003   ,BSS,.         ; CYCL — цикл превращения 8-ричных цифр; S6:5052
        ,NTR,DS00      ; NTR; S6:5052
        ,XTA,OSOCT     ; XTA OCT-C; S6:5053
        ,UTC,OSC1      ; UTC C1; S6:5054
        ,A/X,DS00      ; A/X; S6:5055
        ,NTR,OI03      ; NTR 3; S6:5056
        ,A+X,OSINT     ; A+X INT0-C; S6:5057
        ,ATX,DS00      ; ATX; S6:5058
        ,NTR,OI02      ; NTR 2; S6:5059
        ,UTC,OSC1      ; UTC C1; S6:5060
        ,A*X,DS00      ; A*X; S6:5061
        ,X-A,OSOCT     ; X-A OCT-C; S6:5062
        ,STX,OSOCT     ; STX OCT-C; S6:5063
        ,AAX,OMSK15    ; AAX MASK15-C; S6:5064
        ,AOX,OSDEC     ; AOX DEC-C; S6:5065
        ,VLM,OS6SY     ; VLM /6SYMB; S6:5066
        ,AOX,OZEROS    ; AOX ZERO-C; S6:5067
        ,NTR,OI10      ; NTR 10; S6:5068
        ,UJ,DS00       ; UJ; S6:5069
OS6SY   ,BSS,.         ; /6SYMB — подпрограмма 6 символов; S6:5071
        ,ASN,OI64M8    ; ASN 64-8; S6:5072
        ,ATX,OSDEC     ; ATX DEC-C; S6:5073
        ,UJ,OS003      ; UJ CYCL; S6:5074
OSOCT   ,OCT,DS00      ; OCT — буфер числа; S6:5075
OSDEC   ,OCT,DS00      ; DEC — буфер результата; S6:5077
OSINT   ,INT,OINT0     ; INT0 = 0; S6:5075
OSC1    ,REAL,OREAL1   ; C1 = 1.0; S6:5082
        ,REAL,ORL10  ; 10.0; S6:5081
        ,REAL,ORL100 ; 100.0; S6:5080
        ,REAL,ORL1K  ; 1000.0; S6:5079
        ,REAL,ORL10K ; 10000.0; S6:5078
        ,REAL,ORL1E5; 100000.0; S6:5077
        ,ISO,OZEROS    ; ZERO ISO '000000'; S6:5083
