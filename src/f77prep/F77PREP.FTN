      PROGRAM F77PREP
C=======================================================================
C F77PREP -- E3 minimal F77 -> FOREX 2.02 preprocessor.
C
C Input : NL lines of 72 ASCII character codes held in C(72,20).  The
C         host script injects DATA NL /.../ and DATA C /.../ at the
C         injection marker below (a comment line).  This substitutes for
C         reading cards: no Fortran READ unit consuming the input card
C         stream has been found for FOREX 2.02 (E1 pending).
C
C Output: numeric records (markers 777001/777002/777003), because the
C         A-format and CHARACTER output are not usable on FOREX 2.02.
C           777001 <line> <rule> <itype>   rule per source line
C           777002 <pos> <char-code>      chars of a rewritten variable
C           777003 <nlines> <nrewrites>   summary
C
C Rules: 1 IMPLICIT NONE -> drop; 2 SAVE ... -> drop;
C        3 PRINT *,var -> PRINT 9000,var (FORMAT 9000 added by host).
C        itype: 1 = integer (I..N implicit), 2 = real.
C Subset: INTEGER, DIMENSION, DATA, DO, GOTO, PRINT n,I  (no IMPLICIT,
C         SAVE, CHARACTER, list-directed I/O, READ).
C=======================================================================
      INTEGER C(72,20)
      INTEGER NL
      INTEGER PATIMP(13), PATSAV(5), PATPRN(7)
      DATA PATIMP /73,77,80,76,73,67,73,84,32,78,79,78,69/
      DATA PATSAV /83,65,86,69,32/
      DATA PATPRN /80,82,73,78,84,32,42/
C@@DATA@@
      INTEGER IV(20)
      INTEGER I, J, K, IFIRST, LV, MATCH, IRULE, ITYPE, NR
      NR = 0
      DO 100 I = 1, NL
         IRULE = 0
         ITYPE = 0
         LV = 0
         IFIRST = 1
   10    IF (IFIRST .GT. 72) GOTO 20
         IF (C(IFIRST,I) .EQ. 32) GOTO 15
         GOTO 20
   15    IFIRST = IFIRST + 1
         GOTO 10
   20    MATCH = 1
         DO 30 J = 1, 13
            IF (C(IFIRST+J-1,I) .NE. PATIMP(J)) MATCH = 0
   30    CONTINUE
         IF (MATCH .EQ. 1) IRULE = 1
         IF (IRULE .NE. 0) GOTO 80
         MATCH = 1
         DO 40 J = 1, 5
            IF (C(IFIRST+J-1,I) .NE. PATSAV(J)) MATCH = 0
   40    CONTINUE
         IF (MATCH .EQ. 1) IRULE = 2
         IF (IRULE .NE. 0) GOTO 80
         MATCH = 1
         DO 50 J = 1, 7
            IF (C(IFIRST+J-1,I) .NE. PATPRN(J)) MATCH = 0
   50    CONTINUE
         IF (MATCH .NE. 1) GOTO 80
         IRULE = 3
         ITYPE = 2
         K = IFIRST + 7
   60    IF (K .GT. 72) GOTO 80
         IF (C(K,I) .EQ. 32) GOTO 65
         IF (C(K,I) .EQ. 44) GOTO 65
         GOTO 70
   65    K = K + 1
         GOTO 60
   70    LV = 1
         IV(1) = C(K,I)
         IF (IV(1) .GE. 73 .AND. IV(1) .LE. 78) ITYPE = 1
         K = K + 1
   75    IF (K .GT. 72) GOTO 85
         IF (C(K,I) .EQ. 32) GOTO 85
         LV = LV + 1
         IV(LV) = C(K,I)
         K = K + 1
         GOTO 75
   85    NR = NR + 1
   80    PRINT 9001, 777001, I, IRULE, ITYPE
         IF (IRULE .NE. 3) GOTO 95
         DO 90 K = 1, LV
            PRINT 9002, 777002, I, K, IV(K)
   90    CONTINUE
   95    CONTINUE
  100 CONTINUE
      PRINT 9003, 777003, NL, NR
 9001 FORMAT(1X,4I8)
 9002 FORMAT(1X,4I8)
 9003 FORMAT(1X,3I8)
      STOP
      END
