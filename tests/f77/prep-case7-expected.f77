      PROGRAM PREP7
C@ CHARACTER*10 S -> INTEGER IS(2)
      INTEGER IS(2)
C@ CHARACTER*6 T -> INTEGER IT
      INTEGER IT
C@ S='ABCDEF' -> DATA IS(1)/6HABCDEF/
      DATA IS(1)/6HABCDEF/
C@ T = S(2:4) // 'XY' -> CALL SUBSTR(IS,2,4,IW5)
      CALL SUBSTR(IS,2,4,IW5)
      DATA IL5/2HXY/
C@ T = S(2:4) // 'XY' -> CALL STRCAT(IW5,IL5,IT,3,2)
      CALL STRCAT(IW5,IL5,IT,3,2)
C@ IF (S .EQ. T) GO TO 99 -> KC6 = ISTRCM(IS,IT)
      KC6 = ISTRCM(IS,IT)
      IF (KC6 .EQ. 0) GO TO 99
C@ PRINT *, S -> PRINT 9000,IS(1),IS(2)
      PRINT 9000,IS(1),IS(2)
   99 CONTINUE
      STOP
C@ (end of program) -> 9000 FORMAT(1X,A6,A4)
 9000 FORMAT(1X,A6,A4)
      END
