      PROGRAM F23
      INTEGER K,OP,EX
      OPEN(21,FILE='TEST',STATUS='NEW',IOSTAT=K,ERR=90)
      INQUIRE(UNIT=21,OPENED=OP,EXIST=EX,IOSTAT=K)
      PRINT 10,OP,EX,K
   10 FORMAT(1X,'OP ',I2,' EX ',I2,' K ',I2)
      CLOSE(21,STATUS='DELETE',IOSTAT=K)
      PRINT 20,K
   20 FORMAT(1X,'K ',I2)
      STOP
   90 PRINT 21
   21 FORMAT(1X,'BAD')
      END
