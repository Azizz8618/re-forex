C---- I02: CHARACTER*10 ASSIGNMENT AND SUBSTRING S(2:4).
      PROGRAM I02
C@ CHARACTER*10 S -> INTEGER IS(2)
      INTEGER IS(2)
C@ S='ABCDE' -> DATA IS(1)/6HABCDE /; DATA IS(2)/6H      /
      DATA IS(1)/6HABCDE /
      DATA IS(2)/6H      /
C@ PRINT 10,S(2:4) -> DATA IW5/6HBCD   / ; PRINT 10,IW5
      DATA IW5/6HBCD   /
      PRINT 10,IW5
   10 FORMAT(1X,A4)
      STOP
      END
