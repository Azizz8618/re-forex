c---- E04: counted DO with negative step.
      PROGRAM E04
      INTEGER S
      S=0
      DO 20 I=10,1,-2
         S=S+I
   20 CONTINUE
      PRINT 30,S
   30 FORMAT(1X,I4)
      STOP
      END
*execute
*end file
