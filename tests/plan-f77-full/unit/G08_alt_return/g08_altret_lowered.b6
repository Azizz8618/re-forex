*name G8low
*call yesmemory
*perso:602300
*no list
*forex
      PROGRAM G8L
      INTEGER RC
      CALL SUB(RC)
      GO TO (10,20,50),RC
   10 K=1
      GO TO 60
   20 K=2
      GO TO 60
   50 K=3
   60 PRINT 70,K
   70 FORMAT(1X,I4)
      STOP
      END
      SUBROUTINE SUB(RC)
      INTEGER RC
      RC=1
      RETURN
      END
*execute
