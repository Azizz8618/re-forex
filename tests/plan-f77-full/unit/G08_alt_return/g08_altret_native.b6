*name G8
*call yesmemory
*perso:602300
*no list
*forex
      PROGRAM G8
      CALL SUB(*10,*20)
      GO TO 50
   10 K=1
      GO TO 60
   20 K=2
      GO TO 60
   50 K=3
   60 PRINT 70,K
   70 FORMAT(1X,I4)
      STOP
      END
      SUBROUTINE SUB(*,*)
      RETURN 1
      END
*execute
*end file
