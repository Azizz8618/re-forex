*name J2_ARF
*call yesmemory
*perso:602300
*full list
*forex
      PROGRAM J2W
C ---- J2: WRITE(u,fmt) через PERSO 0o2320 ZF-мост --------------------
C ---- реальный Э63/Э70 мост G1: run-f77-prep.sh case24 ---------------
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      INTEGER NM(2), A, B, C, D, K, IB(20)
      DATA NM /12HDATA        /
      FM(4)=2
      CALL ZFOPEN(NM,22,FM(1))
      K=FM(1)
      A=12
      B=34
      C=0
      D=0
      ENCODE(72,10,IB) A,B
   10 FORMAT(1X,2I6)
      CALL ZFWRIT(22,IB,12,FM(1))
      CALL ZFREAD(22,IB,12,FM(1))
      DECODE(72,10,IB) C,D
      PRINT 20,C,D,K
   20 FORMAT(1X,'W C ',I4,' D ',I4,' K ',I3)
      CALL ZFCLOSE(22,1,FM(1))
      STOP
      END
      SUBROUTINE ZFOPEN(NA,LU,IS)
      INTEGER NA(2),LU,IS
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      FM(1)=0
      FM(2)=1
      FM(3)=1
      FM(8)=0
      END
      SUBROUTINE ZFCLOSE(LU,DL,IS)
      INTEGER LU,DL,IS
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      FM(2)=0
      FM(8)=0
      FM(1)=0
      END
      SUBROUTINE ZFINQ(LU,OP,EX,IS)
      INTEGER LU,OP,EX,IS
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      OP=FM(2)
      EX=FM(3)
      FM(1)=0
      END
      SUBROUTINE ZFWRIT(LU,BU,N,IS)
      INTEGER LU,BU(20),N,IS
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      INTEGER I
      DO 11 I=1,N
        FM(8+I)=BU(I)
   11 CONTINUE
      FM(8)=N
      FM(1)=0
      END
      SUBROUTINE ZFREAD(LU,BU,N,IS)
      INTEGER LU,BU(20),N,IS
      INTEGER FM(20)
      COMMON /FILMAP/ FM
      INTEGER I
      IF (FM(8) .EQ. 0) GO TO 31
      DO 21 I=1,N
        BU(I)=FM(8+I)
   21 CONTINUE
      FM(8)=0
      FM(1)=0
      RETURN
   31 FM(1)=-1
      END
*execute
*end file
``````
еконец
