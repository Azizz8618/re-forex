*name F11low
*call yesmemory
*perso:602300
*no list
*forex
      PROGRAM F11L
      INTEGER A,B
      CALL CNT(A)
      CALL CNT(B)
      PRINT 10,A,B
   10 FORMAT(1X,2I4)
      STOP
      END
      SUBROUTINE CNT(K)
      INTEGER N
      COMMON /F11SV/N
      N=N+1
      K=N
      RETURN
      END
      BLOCK DATA
      INTEGER N
      COMMON /F11SV/N
      DATA N/10/
      END
*execute
*end file
