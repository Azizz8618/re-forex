c---- B02: DOUBLE PRECISION and D22.15 (48-bit word control).
      PROGRAM B02
      DOUBLE PRECISION X,Y
      X=2.0D0
      Y=SQRT(X)
      PRINT 10,Y
   10 FORMAT(1X,D22.15)
      STOP
      END
