c---- D3 lowered (rules 8/12/14): DATA + SUBSTR (ASCII codes).
      PROGRAM D03LOW
      INTEGER IS(6),IW(8),IWD(8)
      DATA IS/65,66,67,68,69,70/
C@ static-fold variant (DATA precedes all executables): IWD/6HBCD   /
      DATA IWD(1)/6HBCD   /
C@ S(2:4) -> CALL SUBSTR(IS,2,4,IW)
      CALL SUBSTR(IS,2,4,IW)
      PRINT 10,(IW(I),I=1,3)
   10 FORMAT(1X,3I3)
      PRINT 11,IWD
   11 FORMAT(1X,A4)
      STOP
      END
*execute
*end file
