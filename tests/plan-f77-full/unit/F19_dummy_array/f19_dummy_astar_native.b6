*name F19s
*call yesmemory
*perso:602300
*no list
*forex
      PROGRAM F19S
      INTEGER V(5)
      DATA V/1,2,3,4,5/
      CALL SUM(V,5,S)
      PRINT 10,S
   10 FORMAT(1X,I4)
      STOP
      END
      SUBROUTINE SUM(A,N,S)
      INTEGER A(*),S
      S=0
      DO 20 I=1,N
   20 S=S+A(I)
      RETURN
      END
*execute
*end file
