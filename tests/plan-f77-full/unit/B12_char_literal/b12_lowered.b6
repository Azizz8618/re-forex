*name B12LOW
*call yesmemory
*perso:602300
*no list
*forex
c---- B12 lowered (rule 8/12): '...' -> DATA nH / ASCII array.
      PROGRAM B12LOW
      INTEGER IS(6),IT
C@ S='ABCDEF' -> DATA IS/65,66,67,68,69,70/
      DATA IS/65,66,67,68,69,70/
C@ DATA S/'UVWXYZ'/ -> DATA IT/6HUVWXYZ/
      DATA IT/6HUVWXYZ/
      PRINT 10,(IS(I),I=1,6)
   10 FORMAT(1X,6I3)
      PRINT 11,IT
   11 FORMAT(1X,A6)
      STOP
      END
*execute
*end file
