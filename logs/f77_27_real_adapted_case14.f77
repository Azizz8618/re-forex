      PROGRAM G8L
C@ CALL SUB(*10,*20) -> INTEGER RC / CALL SUB(RC)
C@ R-G8 -> GO TO (10,20,90000),RC / 90000 CONTINUE
      INTEGER RC
      CALL SUB(RC)
      GO TO (10,20,90000),RC
90000 CONTINUE
   10 K=1
      GO TO 60
   20 K=2
   60 PRINT 70,K
   70 FORMAT(1X,I4)
      END
C@ SUBROUTINE SUB(RC) -> SUBROUTINE SUB(RC) / INTEGER RC
      SUBROUTINE SUB(RC)
      INTEGER RC
C@ RETURN 1 -> RC=1 / RETURN
      RC=1
      RETURN
      END
