      PROGRAM E9V
      S=-1
      T=0
C@ DO 20 I=1,0,S -> IF-GUARD(S) / 90000 CONTINUE
      IF (S .GE. 0) GO TO 90001
      IF (1 .LT. 0) GO TO 90000
      GO TO 90002
90001 CONTINUE
      IF (1 .GT. 0) GO TO 90000
90002 CONTINUE
      DO 20 I=1,0,S
   20 T=T+I
90000 CONTINUE
      S=1
C@ DO 30 I=1,0,S -> IF-GUARD(S) / 90003 CONTINUE
      IF (S .GE. 0) GO TO 90004
      IF (1 .LT. 0) GO TO 90003
      GO TO 90005
90004 CONTINUE
      IF (1 .GT. 0) GO TO 90003
90005 CONTINUE
      DO 30 I=1,0,S
   30 T=T+I
90003 CONTINUE
      PRINT 40,T
   40 FORMAT(1X,I4)
      END
