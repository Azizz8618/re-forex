      PROGRAM G4L
      INTEGER IS
C@ IS=CFUN() -> CALL CFUN(IS)
      CALL CFUN(IS)
      PRINT 10,IS
   10 FORMAT(1X,A4)
      END
C@ CHARACTER*4 FUNCTION CFUN() -> SUBROUTINE CFUN(RV) / INTEGER RV
      SUBROUTINE CFUN(RV)
      INTEGER RV,IH
C@ CFUN='ABCD' -> DATA IH/...Hollerith.../ / RV=IH
      DATA IH/4HABCD/
      RV=IH
      RETURN
      END
