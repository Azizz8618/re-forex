 #include "defs.h"
 #include "optab.h"
 #include "encoding.h"
+#include "disk.h"
+
+/* C3: the monitor assembles the VJM at RAM 0o455 from page 0o64000 at boot.
+ * At that exact moment we put OUR code (body words 9..19 of disk 2148 zone
+ * 0o1745) into RAM 0o1770..0o1782, so the patched VJM jumps to real code.
+ * The words come from the on-disk body, not from an env var or a literal. */
+void
+c3_install_our_words(void)
+{
+        static int done = 0;
+        void *dh;
+        char buf[ZONE_SIZE];
+        int i, k;
+
+        if (done)
+                return;
+        done = 1;
+        dh = disk_open(2148, DISK_READ_ONLY);
+        if (!dh) {
+                fprintf(stderr, "C3: cannot open disk 2148 for body words\n");
+                return;
+        }
+        if (disk_readi(dh, 01745, buf, NULL, NULL, DISK_MODE_QUIET) != DISK_IO_OK) {
+                fprintf(stderr, "C3: cannot read body zone 01745 from disk 2148\n");
+                disk_close(dh);
+                return;
+        }
+        disk_close(dh);
+        for (i = 0; i < 11; ++i) {
+                for (k = 0; k < 6; ++k)
+                        core[01770 + i].w_b[k] = buf[(9 + i) * 6 + k];
+                cflags[01770 + i] &= ~C_UNPACKED;
+        }
+        fprintf(stderr, "C3: loaded 11 body words from disk 2148 zone 01745 "
+                        "into RAM 01770..01782\n");
+}
 
